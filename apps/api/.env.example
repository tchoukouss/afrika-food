# --- Base de données PostgreSQL ---
DATABASE_URL=postgresql://afrika_food:MOT_DE_PASSE@localhost:5432/afrika_food

# --- Sécurité ---
# Chaîne aléatoire d'au moins 32 caractères (générer avec :
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))")
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# --- Serveur ---
PORT=3000
NODE_ENV=development
# Origines autorisées du frontend, séparées par des virgules
CORS_ORIGINS=http://localhost:5173

# --- Initialisation (npm run db:seed) ---
SEED_COMPANY_NAME=AFRIKA FOOD
SEED_ADMIN_NAME=Administrateur
SEED_ADMIN_EMAIL=admin@afrikafood.ci
SEED_ADMIN_PASSWORD=
