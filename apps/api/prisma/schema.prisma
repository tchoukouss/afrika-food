// --- Transferts entre établissements ------------------------------------------

enum TransferStatus {
  REQUESTED
  VALIDATED
  PREPARED
  SHIPPED
  RECEIVED
  CLOSED
  CANCELLED
}

model StockTransfer {
  id                    String         @id @default(uuid()) @db.Uuid
  companyId             String         @map("company_id") @db.Uuid
  // Identifiant envoyé par le formulaire : un même envoi (double clic, renvoi
  // après coupure réseau) ne crée jamais deux documents.
  clientRequestId       String?        @map("client_request_id") @db.Uuid
  number                String
  sourceEstablishmentId String         @map("source_establishment_id") @db.Uuid
  sourceLocationId      String?        @map("source_location_id") @db.Uuid
  destEstablishmentId   String         @map("dest_establishment_id") @db.Uuid
  destLocationId        String?        @map("dest_location_id") @db.Uuid
  status                TransferStatus @default(REQUESTED)
  notes                 String?
  requestedById         String         @map("requested_by_id") @db.Uuid
  requestedAt           DateTime       @default(now()) @map("requested_at") @db.Timestamptz(3)
  validatedById         String?        @map("validated_by_id") @db.Uuid
  validatedAt           DateTime?      @map("validated_at") @db.Timestamptz(3)
  preparedById          String?        @map("prepared_by_id") @db.Uuid
  preparedAt            DateTime?      @map("prepared_at") @db.Timestamptz(3)
  shippedById           String?        @map("shipped_by_id") @db.Uuid
  shippedAt             DateTime?      @map("shipped_at") @db.Timestamptz(3)
  receivedById          String?        @map("received_by_id") @db.Uuid
  receivedAt            DateTime?      @map("received_at") @db.Timestamptz(3)
  closedById            String?        @map("closed_by_id") @db.Uuid
  closedAt              DateTime?      @map("closed_at") @db.Timestamptz(3)
  cancelledById         String?        @map("cancelled_by_id") @db.Uuid
  cancelledAt           DateTime?      @map("cancelled_at") @db.Timestamptz(3)
  cancelReason          String?        @map("cancel_reason")
  createdAt             DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  items StockTransferItem[]

  @@unique([companyId, number])
  @@unique([companyId, clientRequestId])
  @@index([sourceEstablishmentId, status])
  @@index([destEstablishmentId, status])
  @@map("stock_transfers")
}

model StockTransferItem {
  id                String   @id @default(uuid()) @db.Uuid
  transferId        String   @map("transfer_id") @db.Uuid
  rawMaterialId     String?  @map("raw_material_id") @db.Uuid
  productId         String?  @map("product_id") @db.Uuid
  requestedQuantity Decimal  @map("requested_quantity") @db.Decimal(18, 4)
  // Quantité préparée (peut différer de la demande), puis expédiée et reçue.
  preparedQuantity  Decimal? @map("prepared_quantity") @db.Decimal(18, 4)
  shippedQuantity   Decimal? @map("shipped_quantity") @db.Decimal(18, 4)
  receivedQuantity  Decimal? @map("received_quantity") @db.Decimal(18, 4)
  gapReason         String?  @map("gap_reason")

  transfer StockTransfer      @relation(fields: [transferId], references: [id])
  lots     StockTransferLot[]

  @@index([transferId])
  @@map("stock_transfer_items")
}

// Lots expédiés pour une ligne de transfert (traçabilité de bout en bout).
model StockTransferLot {
  id               String   @id @default(uuid()) @db.Uuid
  transferItemId   String   @map("transfer_item_id") @db.Uuid
  lotId            String   @map("lot_id") @db.Uuid
  shippedQuantity  Decimal  @map("shipped_quantity") @db.Decimal(18, 4)
  receivedQuantity Decimal? @map("received_quantity") @db.Decimal(18, 4)
  unitCost         Decimal  @map("unit_cost") @db.Decimal(18, 4)

  transferItem StockTransferItem @relation(fields: [transferItemId], references: [id])

  @@map("stock_transfer_lots")
}

// ===========================================================================
// Module 4 — Recettes & production.
//
// Comme pour le module 3, aucune relation Prisma vers les modèles des modules
// précédents (produits, matières, établissements, lots, emplacements,
// utilisateurs) : les clés étrangères sont déclarées en SQL dans la migration.
// Ingrédient = matière première OU produit fabriqué / revendu (sous-recette).
// Quantités : Decimal(18,4). Coûts : FCFA (Decimal).
// ===========================================================================

enum RecipeVersionStatus {
  DRAFT // en préparation, modifiable
  ACTIVE // version en vigueur (une seule par recette)
  ARCHIVED // ancienne version, consultable, jamais modifiée
}

// Fiche technique d'un produit fabriqué (une par produit, niveau groupe).
model Recipe {
  id              String   @id @default(uuid()) @db.Uuid
  companyId       String   @map("company_id") @db.Uuid
  productId       String   @unique @map("product_id") @db.Uuid
  activeVersionId String?  @unique @map("active_version_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  versions RecipeVersion[]

  @@index([companyId])
  @@map("recipes")
}

model RecipeVersion {
  id            String              @id @default(uuid()) @db.Uuid
  recipeId      String              @map("recipe_id") @db.Uuid
  version       Int
  status        RecipeVersionStatus @default(DRAFT)
  // Rendement : quantité de produit obtenue, dans l'unité de vente du produit.
  yieldQuantity Decimal             @map("yield_quantity") @db.Decimal(18, 4)
  // Durée de conservation du produit fini (jours) : fixe la péremption du lot produit.
  shelfLifeDays Int?                @map("shelf_life_days")
  instructions  String?
  notes         String?
  createdById   String              @map("created_by_id") @db.Uuid
  activatedById String?             @map("activated_by_id") @db.Uuid
  activatedAt   DateTime?           @map("activated_at") @db.Timestamptz(3)
  archivedAt    DateTime?           @map("archived_at") @db.Timestamptz(3)
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  recipe Recipe       @relation(fields: [recipeId], references: [id])
  items  RecipeItem[]

  @@unique([recipeId, version])
  @@map("recipe_versions")
}

model RecipeItem {
  id            String  @id @default(uuid()) @db.Uuid
  versionId     String  @map("version_id") @db.Uuid
  rawMaterialId String? @map("raw_material_id") @db.Uuid
  productId     String? @map("product_id") @db.Uuid
  // Quantité pour le rendement de la version, dans l'unité indiquée (g, kg, mL, L, u…).
  quantity      Decimal @db.Decimal(18, 4)
  unitCode      String  @map("unit_code")
  // Perte prévue sur l'ingrédient (épluchage, évaporation…), en %.
  lossPercent   Decimal @default(0) @map("loss_percent") @db.Decimal(5, 2)
  note          String?
  sortOrder     Int     @default(0) @map("sort_order")

  version RecipeVersion @relation(fields: [versionId], references: [id])

  @@index([versionId])
  @@map("recipe_items")
}

enum ProductionStatus {
  PLANNED
  VALIDATED // matières réservées
  IN_PROGRESS // matières consommées
  COMPLETED // produits finis entrés en stock
  CONTROLLED // contrôle qualité effectué
  CANCELLED
}

enum ProductionLossStage {
  COMPLETION // écart entre quantité prévue et produite
  CONTROL // non-conformité constatée au contrôle
}

model ProductionOrder {
  id               String           @id @default(uuid()) @db.Uuid
  companyId        String           @map("company_id") @db.Uuid
  establishmentId  String           @map("establishment_id") @db.Uuid
  number           String
  clientRequestId  String?          @map("client_request_id") @db.Uuid
  productId        String           @map("product_id") @db.Uuid
  // Version de recette figée à la création de l'ordre.
  recipeVersionId  String           @map("recipe_version_id") @db.Uuid
  status           ProductionStatus @default(PLANNED)
  plannedQuantity  Decimal          @map("planned_quantity") @db.Decimal(18, 4)
  producedQuantity Decimal?         @map("produced_quantity") @db.Decimal(18, 4)
  plannedDate      DateTime?        @map("planned_date") @db.Date
  // Emplacement de sortie des matières et d'entrée des produits finis.
  sourceLocationId String           @map("source_location_id") @db.Uuid
  destLocationId   String           @map("dest_location_id") @db.Uuid
  notes            String?
  // Coûts : théorique (estimation à la création), réel (lots consommés), unitaire réel.
  theoreticalCost  Decimal?         @map("theoretical_cost") @db.Decimal(18, 2)
  realCost         Decimal?         @map("real_cost") @db.Decimal(18, 2)
  unitCost         Decimal?         @map("unit_cost") @db.Decimal(18, 4)
  overReason       String?          @map("over_reason")
  controlNote      String?          @map("control_note")
  cancelReason     String?          @map("cancel_reason")
  createdById      String           @map("created_by_id") @db.Uuid
  validatedById    String?          @map("validated_by_id") @db.Uuid
  validatedAt      DateTime?        @map("validated_at") @db.Timestamptz(3)
  startedById      String?          @map("started_by_id") @db.Uuid
  startedAt        DateTime?        @map("started_at") @db.Timestamptz(3)
  completedById    String?          @map("completed_by_id") @db.Uuid
  completedAt      DateTime?        @map("completed_at") @db.Timestamptz(3)
  controlledById   String?          @map("controlled_by_id") @db.Uuid
  controlledAt     DateTime?        @map("controlled_at") @db.Timestamptz(3)
  cancelledById    String?          @map("cancelled_by_id") @db.Uuid
  cancelledAt      DateTime?        @map("cancelled_at") @db.Timestamptz(3)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  items        ProductionItem[]
  reservations ProductionReservation[]
  consumptions ProductionConsumption[]
  outputs      ProductionOutput[]
  losses       ProductionLoss[]

  @@unique([companyId, number])
  @@unique([companyId, clientRequestId])
  @@index([establishmentId, status])
  @@map("production_orders")
}

// Besoin théorique par ingrédient, converti dans l'unité de stock de l'article.
model ProductionItem {
  id                  String  @id @default(uuid()) @db.Uuid
  orderId             String  @map("order_id") @db.Uuid
  rawMaterialId       String? @map("raw_material_id") @db.Uuid
  productId           String? @map("product_id") @db.Uuid
  recipeQuantity      Decimal @map("recipe_quantity") @db.Decimal(18, 4)
  recipeUnitCode      String  @map("recipe_unit_code")
  lossPercent         Decimal @default(0) @map("loss_percent") @db.Decimal(5, 2)
  theoreticalQuantity Decimal @map("theoretical_quantity") @db.Decimal(18, 4)
  // Net consommé (théorique + suppléments − retours).
  consumedQuantity    Decimal @default(0) @map("consumed_quantity") @db.Decimal(18, 4)

  order ProductionOrder @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@map("production_items")
}

// Réservation d'un solde (lot × emplacement) pour un ordre validé.
model ProductionReservation {
  id         String    @id @default(uuid()) @db.Uuid
  orderId    String    @map("order_id") @db.Uuid
  itemId     String    @map("item_id") @db.Uuid
  balanceId  String    @map("balance_id") @db.Uuid
  quantity   Decimal   @db.Decimal(18, 4)
  releasedAt DateTime? @map("released_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  order ProductionOrder @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([balanceId])
  @@map("production_reservations")
}

enum ConsumptionKind {
  THEORETICAL // sortie au lancement selon la recette
  EXTRA // supplément déclaré à la fin
  RETURN // reste rendu au stock (quantité négative)
}

// Consommation réelle par lot (traçabilité matière → produit).
model ProductionConsumption {
  id         String          @id @default(uuid()) @db.Uuid
  orderId    String          @map("order_id") @db.Uuid
  itemId     String          @map("item_id") @db.Uuid
  lotId      String          @map("lot_id") @db.Uuid
  locationId String          @map("location_id") @db.Uuid
  kind       ConsumptionKind
  // Positive = consommée ; négative = rendue au stock.
  quantity   Decimal         @db.Decimal(18, 4)
  unitCost   Decimal         @map("unit_cost") @db.Decimal(18, 4)
  value      Decimal         @db.Decimal(18, 2)
  reason     String?
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  order ProductionOrder @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([lotId])
  @@map("production_consumptions")
}

// Lot de produit fini créé par la production.
model ProductionOutput {
  id         String   @id @default(uuid()) @db.Uuid
  orderId    String   @map("order_id") @db.Uuid
  lotId      String   @unique @map("lot_id") @db.Uuid
  locationId String   @map("location_id") @db.Uuid
  quantity   Decimal  @db.Decimal(18, 4)
  unitCost   Decimal  @map("unit_cost") @db.Decimal(18, 4)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  order ProductionOrder @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@map("production_outputs")
}

model ProductionLoss {
  id          String              @id @default(uuid()) @db.Uuid
  orderId     String              @map("order_id") @db.Uuid
  stage       ProductionLossStage
  quantity    Decimal             @db.Decimal(18, 4)
  cause       LossCause
  reason      String
  value       Decimal             @db.Decimal(18, 2)
  // Perte enregistrée au stock (module 3) lors d'une non-conformité au contrôle.
  stockLossId String?             @map("stock_loss_id") @db.Uuid
  createdById String              @map("created_by_id") @db.Uuid
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  order ProductionOrder @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@map("production_losses")
}

// ===========================================================================
// Module 5 — Caisse & ventes.
//
// Aucune relation Prisma vers les modèles des modules précédents (établissements,
// emplacements, produits, lots, utilisateurs) : clés étrangères en SQL dans la
// migration. Montants : FCFA entiers (BigInt), prix TTC. Quantités : Decimal.
// Rien n'est jamais supprimé ; ventes, paiements, mouvements de caisse,
// remboursements et tickets sont protégés par des triggers.
// ===========================================================================

enum PrinterType {
  NETWORK // imprimante thermique ESC/POS en réseau (Ethernet / Wi-Fi)
  BROWSER // impression par le navigateur du poste
  NONE
}

model CashRegister {
  id              String      @id @default(uuid()) @db.Uuid
  companyId       String      @map("company_id") @db.Uuid
  establishmentId String      @map("establishment_id") @db.Uuid
  code            String
  name            String
  // Emplacement de stock d'où sortent les produits vendus (décision 1).
  stockLocationId String      @map("stock_location_id") @db.Uuid
  printerType     PrinterType @default(BROWSER) @map("printer_type")
  printerHost     String?     @map("printer_host")
  printerPort     Int         @default(9100) @map("printer_port")
  // Largeur du papier en mm (58 ou 80).
  paperWidth      Int         @default(80) @map("paper_width")
  autoPrint       Boolean     @default(true) @map("auto_print")
  isActive        Boolean     @default(true) @map("is_active")
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions CashSession[]

  @@unique([establishmentId, code])
  @@map("cash_registers")
}

enum CashSessionStatus {
  OPEN
  CLOSED // compté et clôturé par le caissier
  VALIDATED // clôture validée par un responsable
}

// Session : une caisse, un caissier (décision 5).
model CashSession {
  id              String            @id @default(uuid()) @db.Uuid
  companyId       String            @map("company_id") @db.Uuid
  establishmentId String            @map("establishment_id") @db.Uuid
  registerId      String            @map("register_id") @db.Uuid
  number          String
  clientRequestId String?           @map("client_request_id") @db.Uuid
  cashierId       String            @map("cashier_id") @db.Uuid
  status          CashSessionStatus @default(OPEN)
  openingFloat    BigInt            @map("opening_float")
  openedAt        DateTime          @default(now()) @map("opened_at") @db.Timestamptz(3)
  closedAt        DateTime?         @map("closed_at") @db.Timestamptz(3)
  closingNote     String?           @map("closing_note")
  validatedById   String?           @map("validated_by_id") @db.Uuid
  validatedAt     DateTime?         @map("validated_at") @db.Timestamptz(3)
  validationNote  String?           @map("validation_note")
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  register  CashRegister   @relation(fields: [registerId], references: [id])
  movements CashMovement[]
  closures  CashClosure[]

  @@unique([companyId, number])
  @@unique([companyId, clientRequestId])
  @@index([establishmentId, status])
  @@map("cash_sessions")
}

enum CashMovementType {
  OPENING_FLOAT // fond de caisse
  SALE // encaissement d'une vente
  SALE_CANCEL // annulation d'une vente (négatif)
  REFUND // remboursement (négatif)
  MANUAL_IN // entrée manuelle autorisée
  MANUAL_OUT // sortie manuelle autorisée (négatif)
  CUSTOMER_PAYMENT // paiement ou acompte d'un client du module 7 (jamais une vente)
  CUSTOMER_REFUND // remboursement d'un client du module 7, ou correction d'un paiement (négatif)
}

// Mouvement de caisse : en ajout seul. amount signé (entrée > 0, sortie < 0).
model CashMovement {
  id              String           @id @default(uuid()) @db.Uuid
  companyId       String           @map("company_id") @db.Uuid
  establishmentId String           @map("establishment_id") @db.Uuid
  sessionId       String           @map("session_id") @db.Uuid
  type            CashMovementType
  method          PaymentMethod
  amount          BigInt
  reason          String?
  saleId          String?          @map("sale_id") @db.Uuid
  returnId        String?          @map("return_id") @db.Uuid
  clientRequestId String?          @map("client_request_id") @db.Uuid
  userId          String           @map("user_id") @db.Uuid
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  session CashSession @relation(fields: [sessionId], references: [id])

  @@unique([companyId, clientRequestId])
  @@index([sessionId])
  @@index([saleId])
  @@map("cash_movements")
}

// Clôture : attendu, compté et écart par moyen de paiement.
model CashClosure {
  id         String        @id @default(uuid()) @db.Uuid
  sessionId  String        @map("session_id") @db.Uuid
  method     PaymentMethod
  expected   BigInt
  counted    BigInt
  difference BigInt
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  session CashSession @relation(fields: [sessionId], references: [id])

  @@unique([sessionId, method])
  @@map("cash_closures")
}

enum SaleStatus {
  COMPLETED
  CANCELLED
  PARTIALLY_REFUNDED
  REFUNDED
}

model Sale {
  id                   String     @id @default(uuid()) @db.Uuid
  companyId            String     @map("company_id") @db.Uuid
  establishmentId      String     @map("establishment_id") @db.Uuid
  registerId           String     @map("register_id") @db.Uuid
  sessionId            String     @map("session_id") @db.Uuid
  // Numéro de ticket : unique, jamais réutilisé, attribué hors transaction (décision 13).
  number               String
  clientRequestId      String?    @map("client_request_id") @db.Uuid
  status               SaleStatus @default(COMPLETED)
  cashierId            String     @map("cashier_id") @db.Uuid
  // Montants TTC : brut, remises (lignes + ticket), total, TVA incluse.
  grossTotal           BigInt     @map("gross_total")
  lineDiscountTotal    BigInt     @map("line_discount_total")
  ticketDiscountAmount BigInt     @map("ticket_discount_amount")
  ticketDiscountReason String?    @map("ticket_discount_reason")
  total                BigInt
  taxTotal             BigInt     @map("tax_total")
  paidTotal            BigInt     @map("paid_total")
  changeGiven          BigInt     @map("change_given")
  // Part mise à crédit (créance du module 7) : jamais un paiement ni un mouvement de caisse.
  creditAmount         BigInt     @default(0) @map("credit_amount")
  // Coût réel des lots vendus (marges).
  costTotal            Decimal    @map("cost_total") @db.Decimal(18, 2)
  refundedTotal        BigInt     @default(0) @map("refunded_total")
  cancelledById        String?    @map("cancelled_by_id") @db.Uuid
  cancelledAt          DateTime?  @map("cancelled_at") @db.Timestamptz(3)
  cancelReason         String?    @map("cancel_reason")
  createdAt            DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  items     SaleItem[]
  payments  SalePayment[]
  returns   SaleReturn[]
  printJobs PrintJob[]

  @@unique([companyId, number])
  @@unique([companyId, clientRequestId])
  @@index([establishmentId, createdAt])
  @@index([sessionId])
  @@map("sales")
}

model SaleItem {
  id               String  @id @default(uuid()) @db.Uuid
  saleId           String  @map("sale_id") @db.Uuid
  // Ordre de saisie de la ligne (ordre d'impression du ticket).
  position         Int
  productId        String  @map("product_id") @db.Uuid
  // Copie au moment de la vente (le catalogue peut évoluer).
  productCode      String  @map("product_code")
  productName      String  @map("product_name")
  // Catégorie du produit figée à la création de la ligne (historique des ventes, module 8).
  categoryId       String?  @map("category_id") @db.Uuid
  categoryName     String?  @map("category_name")
  isMenu           Boolean @default(false) @map("is_menu")
  quantity         Decimal @db.Decimal(18, 4)
  unitPrice        BigInt  @map("unit_price")
  grossAmount      BigInt  @map("gross_amount")
  discountPercent  Decimal? @map("discount_percent") @db.Decimal(5, 2)
  lineDiscount     BigInt  @default(0) @map("line_discount")
  discountReason   String? @map("discount_reason")
  // Part de la remise ticket répartie sur la ligne.
  ticketDiscount   BigInt  @default(0) @map("ticket_discount")
  lineTotal        BigInt  @map("line_total")
  taxRate          Decimal @map("tax_rate") @db.Decimal(5, 2)
  taxAmount        BigInt  @map("tax_amount")
  costTotal        Decimal @map("cost_total") @db.Decimal(18, 2)
  refundedQuantity Decimal @default(0) @map("refunded_quantity") @db.Decimal(18, 4)

  sale Sale          @relation(fields: [saleId], references: [id])
  lots SaleItemLot[]

  @@index([saleId])
  @@index([productId])
  @@map("sale_items")
}

// Lots sortis pour une ligne (pour un menu : lots des composants).
model SaleItemLot {
  id               String  @id @default(uuid()) @db.Uuid
  saleItemId       String  @map("sale_item_id") @db.Uuid
  productId        String  @map("product_id") @db.Uuid
  lotId            String  @map("lot_id") @db.Uuid
  locationId       String  @map("location_id") @db.Uuid
  quantity         Decimal @db.Decimal(18, 4)
  unitCost         Decimal @map("unit_cost") @db.Decimal(18, 4)
  returnedQuantity Decimal @default(0) @map("returned_quantity") @db.Decimal(18, 4)

  saleItem SaleItem @relation(fields: [saleItemId], references: [id])

  @@index([saleItemId])
  @@index([lotId])
  @@map("sale_item_lots")
}

model SalePayment {
  id        String        @id @default(uuid()) @db.Uuid
  saleId    String        @map("sale_id") @db.Uuid
  method    PaymentMethod
  // Montant remis par le client avec ce moyen (espèces : avant rendu de monnaie).
  amount    BigInt
  reference String?
  provider  String
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  sale Sale @relation(fields: [saleId], references: [id])

  @@index([saleId])
  @@map("sale_payments")
}

enum SaleReturnKind {
  CANCEL // annulation complète dans la session ouverte
  REFUND // remboursement (partiel ou total)
}

enum ReturnDisposition {
  RESTOCK // remis en stock (produit intact)
  LOSS // perte « retour client »
}

model SaleReturn {
  id              String         @id @default(uuid()) @db.Uuid
  companyId       String         @map("company_id") @db.Uuid
  establishmentId String         @map("establishment_id") @db.Uuid
  saleId          String         @map("sale_id") @db.Uuid
  // Session d'où sort l'argent rendu.
  sessionId       String         @map("session_id") @db.Uuid
  number          String
  clientRequestId String?        @map("client_request_id") @db.Uuid
  kind            SaleReturnKind
  method          PaymentMethod?
  total           BigInt
  reason          String
  createdById     String         @map("created_by_id") @db.Uuid
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  sale  Sale             @relation(fields: [saleId], references: [id])
  items SaleReturnItem[]

  @@unique([companyId, number])
  @@unique([companyId, clientRequestId])
  @@index([saleId])
  @@map("sale_returns")
}

model SaleReturnItem {
  id          String            @id @default(uuid()) @db.Uuid
  returnId    String            @map("return_id") @db.Uuid
  saleItemId  String            @map("sale_item_id") @db.Uuid
  quantity    Decimal           @db.Decimal(18, 4)
  amount      BigInt
  disposition ReturnDisposition

  saleReturn SaleReturn      @relation(fields: [returnId], references: [id])
  lots       SaleReturnLot[]

  @@index([returnId])
  @@map("sale_return_items")
}

// Lots concernés par un retour : remis en stock (mouvement SALE_RETURN) ou
// sortis en perte « retour client » (stock_loss_id).
model SaleReturnLot {
  id           String            @id @default(uuid()) @db.Uuid
  returnItemId String            @map("return_item_id") @db.Uuid
  saleItemLotId String           @map("sale_item_lot_id") @db.Uuid
  productId    String            @map("product_id") @db.Uuid
  lotId        String            @map("lot_id") @db.Uuid
  locationId   String            @map("location_id") @db.Uuid
  quantity     Decimal           @db.Decimal(18, 4)
  disposition  ReturnDisposition
  stockLossId  String?           @map("stock_loss_id") @db.Uuid

  returnItem SaleReturnItem @relation(fields: [returnItemId], references: [id])

  @@index([returnItemId])
  @@index([lotId])
  @@map("sale_return_lots")
}

enum PrintJobKind {
  TICKET // impression originale
  DUPLICATE // réimpression (mention DUPLICATA), jamais une nouvelle vente
}

enum PrintJobStatus {
  PENDING
  PRINTED // envoyé à l'imprimante réseau
  BROWSER // rendu pour impression par le navigateur
  FAILED
}

model PrintJob {
  id              String         @id @default(uuid()) @db.Uuid
  companyId       String         @map("company_id") @db.Uuid
  establishmentId String         @map("establishment_id") @db.Uuid
  registerId      String?        @map("register_id") @db.Uuid
  saleId          String         @map("sale_id") @db.Uuid
  kind            PrintJobKind
  status          PrintJobStatus @default(PENDING)
  attempts        Int            @default(0)
  lastError       String?        @map("last_error")
  requestedById   String         @map("requested_by_id") @db.Uuid
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  printedAt       DateTime?      @map("printed_at") @db.Timestamptz(3)

  sale Sale @relation(fields: [saleId], references: [id])

  @@index([saleId])
  @@map("print_jobs")
}

// ===========================================================================
// Module 6 — Restaurant & commandes.
//
// Aucune relation Prisma vers les modèles des modules précédents : clés
// étrangères en SQL dans la migration. Prix TTC en FCFA (BigInt), quantités en
// Decimal. Rien n'est jamais supprimé (triggers) : articles retirés, annulés,
// transférés ou regroupés restent dans l'historique.
// ===========================================================================

model RestaurantArea {
  id              String   @id @default(uuid()) @db.Uuid
  companyId       String   @map("company_id") @db.Uuid
  establishmentId String   @map("establishment_id") @db.Uuid
  name            String
  sortOrder       Int      @default(0) @map("sort_order")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tables RestaurantTable[]

  @@unique([establishmentId, name])
  @@map("restaurant_areas")
}

// État posé à la main ; le statut affiché (libre, réservée, attente de
// commande, occupée, attente d'addition) est calculé à partir des commandes
// et des réservations (décision R8).
enum TableState {
  AVAILABLE
  CLEANING // nettoyage (posé automatiquement après paiement complet)
  OUT_OF_SERVICE // hors service
}

model RestaurantTable {
  id              String     @id @default(uuid()) @db.Uuid
  companyId       String     @map("company_id") @db.Uuid
  establishmentId String     @map("establishment_id") @db.Uuid
  areaId          String     @map("area_id") @db.Uuid
  code            String
  capacity        Int
  state           TableState @default(AVAILABLE)
  sortOrder       Int        @default(0) @map("sort_order")
  isActive        Boolean    @default(true) @map("is_active")
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  area RestaurantArea @relation(fields: [areaId], references: [id])

  @@unique([establishmentId, code])
  @@map("restaurant_tables")
}

enum StationKind {
  KITCHEN
  BAR
}

// Poste de préparation : emplacement de stock consommé et imprimante de bons.
model RestaurantStation {
  id              String      @id @default(uuid()) @db.Uuid
  companyId       String      @map("company_id") @db.Uuid
  establishmentId String      @map("establishment_id") @db.Uuid
  name            String
  kind            StationKind
  stockLocationId String      @map("stock_location_id") @db.Uuid
  printerType     PrinterType @default(NONE) @map("printer_type")
  printerHost     String?     @map("printer_host")
  printerPort     Int         @default(9100) @map("printer_port")
  paperWidth      Int         @default(80) @map("paper_width")
  isActive        Boolean     @default(true) @map("is_active")
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([establishmentId, name])
  @@map("restaurant_stations")
}

enum PreparationMode {
  TO_ORDER // préparé à la commande : la recette est consommée à l'envoi
  FROM_STOCK // produit fini sorti du stock à l'envoi
}

// Carte du restaurant d'un établissement (décision R5).
model RestaurantMenuItem {
  id              String          @id @default(uuid()) @db.Uuid
  companyId       String          @map("company_id") @db.Uuid
  establishmentId String          @map("establishment_id") @db.Uuid
  productId       String          @map("product_id") @db.Uuid
  preparation     PreparationMode @default(FROM_STOCK)
  stationId       String?         @map("station_id") @db.Uuid
  isSupplement    Boolean         @default(false) @map("is_supplement")
  sortOrder       Int             @default(0) @map("sort_order")
  isActive        Boolean         @default(true) @map("is_active")
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([establishmentId, productId])
  @@map("restaurant_menu_items")
}

// Options sans prix ni stock (ex. « cuisson : à point »).
model RestaurantOption {
  id              String   @id @default(uuid()) @db.Uuid
  companyId       String   @map("company_id") @db.Uuid
  establishmentId String   @map("establishment_id") @db.Uuid
  productId       String   @map("product_id") @db.Uuid
  label           String
  sortOrder       Int      @default(0) @map("sort_order")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([establishmentId, productId, label])
  @@map("restaurant_options")
}

enum RestaurantOrderMode {
  TABLE
  COUNTER // comptoir
  TAKEAWAY // à emporter
  PHONE // téléphone
  ONLINE // en ligne (saisie manuelle)
  DELIVERY // livraison (suivi complet au module 7)
}

enum RestaurantOrderStatus {
  OPEN
  PAID // soldée
  CANCELLED
  MERGED // regroupée dans une autre commande
}

model RestaurantOrder {
  id              String                @id @default(uuid()) @db.Uuid
  companyId       String                @map("company_id") @db.Uuid
  establishmentId String                @map("establishment_id") @db.Uuid
  number          String
  clientRequestId String?               @map("client_request_id") @db.Uuid
  mode            RestaurantOrderMode
  tableId         String?               @map("table_id") @db.Uuid
  reservationId   String?               @map("reservation_id") @db.Uuid
  covers          Int?
  customerName    String?               @map("customer_name")
  customerPhone   String?               @map("customer_phone")
  deliveryAddress String?               @map("delivery_address")
  expectedAt      DateTime?             @map("expected_at") @db.Timestamptz(3)
  urgent          Boolean               @default(false)
  note            String?
  status          RestaurantOrderStatus @default(OPEN)
  waiterId        String                @map("waiter_id") @db.Uuid
  mergedIntoId    String?               @map("merged_into_id") @db.Uuid
  paidAt          DateTime?             @map("paid_at") @db.Timestamptz(3)
  cancelledAt     DateTime?             @map("cancelled_at") @db.Timestamptz(3)
  cancelledById   String?               @map("cancelled_by_id") @db.Uuid
  cancelReason    String?               @map("cancel_reason")
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  items          RestaurantOrderItem[]
  kitchenTickets RestaurantKitchenTicket[]
  bills          RestaurantBill[]

  @@unique([companyId, number])
  @@unique([companyId, clientRequestId])
  @@index([establishmentId, status])
  @@map("restaurant_orders")
}

enum RestaurantItemStatus {
  DRAFT // saisi, pas encore envoyé (modifiable)
  REMOVED // brouillon retiré (conservé)
  NEW // envoyé, reçu en cuisine
  IN_PREPARATION
  READY
  SERVED
  CANCELLED // entièrement annulé après envoi
}

model RestaurantOrderItem {
  id                String               @id @default(uuid()) @db.Uuid
  orderId           String               @map("order_id") @db.Uuid
  position          Int
  requestId         String?              @map("request_id") @db.Uuid
  productId         String               @map("product_id") @db.Uuid
  // Copie au moment de la saisie : le client paie le prix annoncé (décision R7).
  productCode       String               @map("product_code")
  productName       String               @map("product_name")
  isMenu            Boolean              @default(false) @map("is_menu")
  unitPrice         BigInt               @map("unit_price")
  taxRate           Decimal              @map("tax_rate") @db.Decimal(5, 2)
  quantity          Decimal              @db.Decimal(18, 4)
  note              String?
  options           String[]             @default([])
  // Supplément rattaché à un article.
  parentItemId      String?              @map("parent_item_id") @db.Uuid
  preparation       PreparationMode
  stationId         String?              @map("station_id") @db.Uuid
  status            RestaurantItemStatus @default(DRAFT)
  kitchenTicketId   String?              @map("kitchen_ticket_id") @db.Uuid
  cancelledQuantity Decimal              @default(0) @map("cancelled_quantity") @db.Decimal(18, 4)
  // Coût réel des lots consommés, net des retours et des pertes.
  costTotal         Decimal              @default(0) @map("cost_total") @db.Decimal(18, 2)
  // Addition en cours ou payée qui couvre l'article.
  billId            String?              @map("bill_id") @db.Uuid
  createdById       String               @map("created_by_id") @db.Uuid
  sentById          String?              @map("sent_by_id") @db.Uuid
  sentAt            DateTime?            @map("sent_at") @db.Timestamptz(3)
  statusChangedAt   DateTime             @default(now()) @map("status_changed_at") @db.Timestamptz(3)
  statusChangedById String?              @map("status_changed_by_id") @db.Uuid
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  order        RestaurantOrder         @relation(fields: [orderId], references: [id])
  consumptions RestaurantConsumption[]

  @@index([orderId])
  @@index([kitchenTicketId])
  @@index([billId])
  @@map("restaurant_order_items")
}

// Bon de cuisine / de bar : articles envoyés ensemble à un poste.
model RestaurantKitchenTicket {
  id              String   @id @default(uuid()) @db.Uuid
  companyId       String   @map("company_id") @db.Uuid
  establishmentId String   @map("establishment_id") @db.Uuid
  orderId         String   @map("order_id") @db.Uuid
  stationId       String?  @map("station_id") @db.Uuid
  number          String
  requestId       String?  @map("request_id") @db.Uuid
  urgent          Boolean  @default(false)
  sentById        String   @map("sent_by_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  order RestaurantOrder @relation(fields: [orderId], references: [id])

  @@unique([companyId, number])
  @@index([establishmentId, createdAt])
  @@map("restaurant_kitchen_tickets")
}

enum OrderConsumptionKind {
  CONSUMED // sorti du stock à l'envoi
  RETURNED // rendu au même lot (annulation avant préparation)
  LOST // perte déclarée (annulation après préparation)
}

// Lots consommés par un article (traçabilité jusqu'aux matières premières).
model RestaurantConsumption {
  id             String          @id @default(uuid()) @db.Uuid
  itemId         String          @map("item_id") @db.Uuid
  kind           OrderConsumptionKind
  rawMaterialId  String?         @map("raw_material_id") @db.Uuid
  productId      String?         @map("product_id") @db.Uuid
  lotId          String          @map("lot_id") @db.Uuid
  locationId     String          @map("location_id") @db.Uuid
  quantity       Decimal         @db.Decimal(18, 4)
  unitCost       Decimal         @map("unit_cost") @db.Decimal(18, 4)
  value          Decimal         @db.Decimal(18, 2)
  cancellationId String?         @map("cancellation_id") @db.Uuid
  stockLossId    String?         @map("stock_loss_id") @db.Uuid
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  item RestaurantOrderItem @relation(fields: [itemId], references: [id])

  @@index([itemId])
  @@index([lotId])
  @@map("restaurant_consumptions")
}

// Annulation (totale ou partielle) d'un article déjà envoyé (décision R14).
model RestaurantItemCancellation {
  id              String            @id @default(uuid()) @db.Uuid
  companyId       String            @map("company_id") @db.Uuid
  establishmentId String            @map("establishment_id") @db.Uuid
  clientRequestId String?           @map("client_request_id") @db.Uuid
  itemId          String            @map("item_id") @db.Uuid
  quantity        Decimal           @db.Decimal(18, 4)
  outcome         ReturnDisposition
  lossCause       LossCause?        @map("loss_cause")
  reason          String
  statusAtCancel  RestaurantItemStatus @map("status_at_cancel")
  createdById     String            @map("created_by_id") @db.Uuid
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([companyId, clientRequestId])
  @@index([itemId])
  @@map("restaurant_item_cancellations")
}

enum RestaurantBillStatus {
  OPEN // addition préparée, non payée
  PAID // encaissée : ticket du module 5
  CANCELLED // annulée avant paiement, ou ticket annulé (lignes rouvertes)
}

model RestaurantBill {
  id              String               @id @default(uuid()) @db.Uuid
  companyId       String               @map("company_id") @db.Uuid
  establishmentId String               @map("establishment_id") @db.Uuid
  orderId         String               @map("order_id") @db.Uuid
  number          String
  clientRequestId String?              @map("client_request_id") @db.Uuid
  status          RestaurantBillStatus @default(OPEN)
  total           BigInt
  printCount      Int                  @default(0) @map("print_count")
  saleId          String?              @map("sale_id") @db.Uuid
  paidAt          DateTime?            @map("paid_at") @db.Timestamptz(3)
  createdById     String               @map("created_by_id") @db.Uuid
  cancelledAt     DateTime?            @map("cancelled_at") @db.Timestamptz(3)
  cancelledById   String?              @map("cancelled_by_id") @db.Uuid
  cancelReason    String?              @map("cancel_reason")
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  order RestaurantOrder      @relation(fields: [orderId], references: [id])
  items RestaurantBillItem[]

  @@unique([companyId, number])
  @@unique([companyId, clientRequestId])
  @@unique([saleId])
  @@index([orderId])
  @@map("restaurant_bills")
}

// Contenu figé d'une addition.
model RestaurantBillItem {
  id        String  @id @default(uuid()) @db.Uuid
  billId    String  @map("bill_id") @db.Uuid
  itemId    String  @map("item_id") @db.Uuid
  quantity  Decimal @db.Decimal(18, 4)
  unitPrice BigInt  @map("unit_price")
  amount    BigInt

  bill RestaurantBill @relation(fields: [billId], references: [id])

  @@index([billId])
  @@index([itemId])
  @@map("restaurant_bill_items")
}

enum ReservationStatus {
  CONFIRMED
  SEATED // client arrivé
  NO_SHOW // non venu
  CANCELLED
}

model RestaurantReservation {
  id              String            @id @default(uuid()) @db.Uuid
  companyId       String            @map("company_id") @db.Uuid
  establishmentId String            @map("establishment_id") @db.Uuid
  clientRequestId String?           @map("client_request_id") @db.Uuid
  tableId         String?           @map("table_id") @db.Uuid
  reservedAt      DateTime          @map("reserved_at") @db.Timestamptz(3)
  covers          Int
  name            String
  phone           String?
  note            String?
  status          ReservationStatus @default(CONFIRMED)
  createdById     String            @map("created_by_id") @db.Uuid
  statusChangedAt DateTime?         @map("status_changed_at") @db.Timestamptz(3)
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([companyId, clientRequestId])
  @@index([establishmentId, reservedAt])
  @@map("restaurant_reservations")
}

enum RestaurantPrintKind {
  KITCHEN // bon de cuisine / bar
  BILL // addition provisoire (pas un ticket de caisse)
}

model RestaurantPrintJob {
  id              String              @id @default(uuid()) @db.Uuid
  companyId       String              @map("company_id") @db.Uuid
  establishmentId String              @map("establishment_id") @db.Uuid
  kind            RestaurantPrintKind
  kitchenTicketId String?             @map("kitchen_ticket_id") @db.Uuid
  billId          String?             @map("bill_id") @db.Uuid
  stationId       String?             @map("station_id") @db.Uuid
  registerId      String?             @map("register_id") @db.Uuid
  status          PrintJobStatus      @default(PENDING)
  attempts        Int                 @default(0)
  lastError       String?             @map("last_error")
  requestedById   String              @map("requested_by_id") @db.Uuid
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  printedAt       DateTime?           @map("printed_at") @db.Timestamptz(3)

  @@index([kitchenTicketId])
  @@index([billId])
  @@map("restaurant_print_jobs")
}

// ===========================================================================
// Module 7 — Clients & facturation (étape 1 : clients, encours, crédit).
//
// Clients au niveau du groupe (décision D9) ; aucune relation Prisma vers les
// modèles des modules précédents : clés étrangères en SQL dans la migration.
// Montants en FCFA (BigInt). Rien n'est supprimé (désactivation tracée).
// ===========================================================================

enum CustomerType {
  INDIVIDUAL // particulier
  BUSINESS // entreprise
  WHOLESALER // grossiste
  EVENT // client événementiel
}

model Customer {
  id              String       @id @default(uuid()) @db.Uuid
  companyId       String       @map("company_id") @db.Uuid
  clientRequestId String?      @map("client_request_id") @db.Uuid
  type            CustomerType
  name            String
  phone           String?
  // Téléphone ramené à ses chiffres (indicatif +225 retiré) : unique dans l'entreprise.
  phoneNormalized String?      @map("phone_normalized")
  email           String?
  address         String?
  taxId           String?      @map("tax_id")
  // Limite de crédit en FCFA ; vide = aucun crédit sans autorisation.
  creditLimit     BigInt?      @map("credit_limit")
  paymentTermDays Int          @default(0) @map("payment_term_days")
  notes           String?
  isActive        Boolean      @default(true) @map("is_active")
  createdById     String       @map("created_by_id") @db.Uuid
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  creditOverrides CreditOverride[]
  quotes          Quote[]
  orders          CustomerOrder[]
  payments        CustomerPayment[]
  deposits        Deposit[]
  invoices        Invoice[]

  @@unique([companyId, clientRequestId])
  @@index([companyId, name])
  @@map("customers")
}

// Pré-autorisation de dépassement de crédit (décision D4) : donnée par un
// responsable (« Autoriser un dépassement de crédit ») pour un client, un
// établissement et un montant maximal, valable 1 heure, consommée une seule fois.
model CreditOverride {
  id              String    @id @default(uuid()) @db.Uuid
  companyId       String    @map("company_id") @db.Uuid
  establishmentId String    @map("establishment_id") @db.Uuid
  customerId      String    @map("customer_id") @db.Uuid
  clientRequestId String?   @map("client_request_id") @db.Uuid
  maxAmount       BigInt    @map("max_amount")
  reason          String
  approvedById    String    @map("approved_by_id") @db.Uuid
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt          DateTime? @map("used_at") @db.Timestamptz(3)
  usedById        String?   @map("used_by_id") @db.Uuid
  usedAmount      BigInt?   @map("used_amount")
  // Document qui a consommé l'autorisation (ticket, facture… étapes suivantes).
  usedReference   String?   @map("used_reference")
  cancelledAt     DateTime? @map("cancelled_at") @db.Timestamptz(3)
  cancelledById   String?   @map("cancelled_by_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  customer Customer @relation(fields: [customerId], references: [id])

  @@unique([companyId, clientRequestId])
  @@index([customerId, expiresAt])
  @@map("credit_overrides")
}

// ---------------------------------------------------------------------------
// Module 7, étape 2 : devis, commandes clients et événements.
// Prix TTC figés à la création ; une ligne est un produit du catalogue ou des
// frais propres au module 7 (sans stock, décision D8).
// ---------------------------------------------------------------------------

enum CustomerDocumentKind {
  STANDARD
  EVENT // événement (décision D10) : même circuit, détails en 1 pour 1
}

enum DocumentLineKind {
  PRODUCT
  FEE // frais (livraison, service…) : aucun stock
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED // crée une commande, une seule
  REFUSED
}

model Quote {
  id               String               @id @default(uuid()) @db.Uuid
  companyId        String               @map("company_id") @db.Uuid
  establishmentId  String               @map("establishment_id") @db.Uuid
  customerId       String               @map("customer_id") @db.Uuid
  number           String
  clientRequestId  String?              @map("client_request_id") @db.Uuid
  kind             CustomerDocumentKind @default(STANDARD)
  status           QuoteStatus          @default(DRAFT)
  // « Expiré » est calculé : envoyé et date de validité dépassée.
  validUntil       DateTime             @map("valid_until") @db.Date
  desiredAt        DateTime?            @map("desired_at") @db.Timestamptz(3)
  // Détails d'événement, recopiés dans la commande à l'acceptation.
  event            Json?
  notes            String?
  total            BigInt
  taxTotal         BigInt               @map("tax_total")
  createdById      String               @map("created_by_id") @db.Uuid
  sentAt           DateTime?            @map("sent_at") @db.Timestamptz(3)
  sentById         String?              @map("sent_by_id") @db.Uuid
  acceptedAt       DateTime?            @map("accepted_at") @db.Timestamptz(3)
  acceptedById     String?              @map("accepted_by_id") @db.Uuid
  refusedAt        DateTime?            @map("refused_at") @db.Timestamptz(3)
  refusedById      String?              @map("refused_by_id") @db.Uuid
  refuseReason     String?              @map("refuse_reason")
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  customer Customer             @relation(fields: [customerId], references: [id])
  lines    QuoteLine[]
  history  QuoteStatusHistory[]
  order    CustomerOrder?

  @@unique([companyId, number])
  @@unique([companyId, clientRequestId])
  @@index([establishmentId, status])
  @@index([customerId])
  @@map("quotes")
}

model QuoteLine {
  id          String           @id @default(uuid()) @db.Uuid
  quoteId     String           @map("quote_id") @db.Uuid
  position    Int
  kind        DocumentLineKind
  productId   String?          @map("product_id") @db.Uuid
  productCode String?          @map("product_code")
  label       String
  quantity    Decimal          @db.Decimal(18, 4)
  unitPrice   BigInt           @map("unit_price")
  taxRate     Decimal          @map("tax_rate") @db.Decimal(5, 2)
  lineTotal   BigInt           @map("line_total")
  taxAmount   BigInt           @map("tax_amount")
  note        String?
  // Produit fabriqué pour la commande (ordre de production du module 4) au lieu d'être pris en stock.
  madeToOrder Boolean          @default(false) @map("made_to_order")

  quote Quote @relation(fields: [quoteId], references: [id])

  @@unique([quoteId, position])
  @@map("quote_lines")
}

model QuoteStatusHistory {
  id         String       @id @default(uuid()) @db.Uuid
  quoteId    String       @map("quote_id") @db.Uuid
  fromStatus QuoteStatus? @map("from_status")
  toStatus   QuoteStatus  @map("to_status")
  reason     String?
  userId     String       @map("user_id") @db.Uuid
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  quote Quote @relation(fields: [quoteId], references: [id])

  @@index([quoteId])
  @@map("quote_status_history")
}

enum CustomerOrderStatus {
  DRAFT
  CONFIRMED
  IN_PREPARATION
  READY
  DELIVERED
  COMPLETED
  CANCELLED // possible avant « livrée », avec motif
}

model CustomerOrder {
  id              String               @id @default(uuid()) @db.Uuid
  companyId       String               @map("company_id") @db.Uuid
  establishmentId String               @map("establishment_id") @db.Uuid
  customerId      String               @map("customer_id") @db.Uuid
  number          String
  clientRequestId String?              @map("client_request_id") @db.Uuid
  kind            CustomerDocumentKind @default(STANDARD)
  status          CustomerOrderStatus  @default(DRAFT)
  // Devis d'origine : un devis accepté ne crée qu'une commande.
  quoteId         String?              @unique @map("quote_id") @db.Uuid
  dueAt           DateTime?            @map("due_at") @db.Timestamptz(3)
  notes           String?
  total           BigInt
  taxTotal        BigInt               @map("tax_total")
  createdById     String               @map("created_by_id") @db.Uuid
  confirmedAt     DateTime?            @map("confirmed_at") @db.Timestamptz(3)
  cancelledAt     DateTime?            @map("cancelled_at") @db.Timestamptz(3)
  cancelledById   String?              @map("cancelled_by_id") @db.Uuid
  cancelReason    String?              @map("cancel_reason")
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  customer Customer                     @relation(fields: [customerId], references: [id])
  quote    Quote?                       @relation(fields: [quoteId], references: [id])
  lines      CustomerOrderLine[]
  event      CustomerOrderEvent?
  history    CustomerOrderStatusHistory[]
  deliveries Delivery[]
  deposits   Deposit[]
  invoices   Invoice[]

  @@unique([companyId, number])
  @@unique([companyId, clientRequestId])
  @@index([establishmentId, status])
  @@index([customerId])
  @@map("customer_orders")
}

model CustomerOrderLine {
  id                String           @id @default(uuid()) @db.Uuid
  orderId           String           @map("order_id") @db.Uuid
  position          Int
  kind              DocumentLineKind
  productId         String?          @map("product_id") @db.Uuid
  productCode       String?          @map("product_code")
  // Catégorie du produit figée à la création de la ligne (historique des ventes, module 8).
  categoryId        String?          @map("category_id") @db.Uuid
  categoryName      String?          @map("category_name")
  label             String
  quantity          Decimal          @db.Decimal(18, 4)
  unitPrice         BigInt           @map("unit_price")
  taxRate           Decimal          @map("tax_rate") @db.Decimal(5, 2)
  lineTotal         BigInt           @map("line_total")
  taxAmount         BigInt           @map("tax_amount")
  note              String?
  // Fabriqué pour la commande : pas de réservation à la confirmation, ordre de production lié, lot fini réservé à la fin de production.
  madeToOrder       Boolean          @default(false) @map("made_to_order")
  productionOrderId String?          @map("production_order_id") @db.Uuid
  // Quantité sortie du stock à la remise ou à la livraison (une seule sortie).
  deliveredQuantity Decimal          @default(0) @map("delivered_quantity") @db.Decimal(18, 4)

  order        CustomerOrder           @relation(fields: [orderId], references: [id])
  reservations OrderReservation[]
  issues       CustomerOrderLineIssue[]

  @@unique([orderId, position])
  @@map("customer_order_lines")
}

enum EventType {
  WEDDING // mariage
  BAPTISM // baptême
  BIRTHDAY // anniversaire
  FUNERAL // funérailles
  SEMINAR // séminaire
  CORPORATE_MEAL // repas d'entreprise
  BUFFET
  COCKTAIL
  OTHER
}

model CustomerOrderEvent {
  orderId      String    @id @map("order_id") @db.Uuid
  eventType    EventType @map("event_type")
  eventDate    DateTime  @map("event_date") @db.Timestamptz(3)
  venue        String?
  guests       Int?
  contactName  String?   @map("contact_name")
  contactPhone String?   @map("contact_phone")
  notes        String?

  order CustomerOrder @relation(fields: [orderId], references: [id])

  @@map("customer_order_events")
}

model CustomerOrderStatusHistory {
  id         String               @id @default(uuid()) @db.Uuid
  orderId    String               @map("order_id") @db.Uuid
  fromStatus CustomerOrderStatus? @map("from_status")
  toStatus   CustomerOrderStatus  @map("to_status")
  reason     String?
  userId     String               @map("user_id") @db.Uuid
  createdAt  DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)

  order CustomerOrder @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@map("customer_order_status_history")
}

// Réservation de stock pour une ligne de commande : préparée ici, utilisée
// par le moteur de stock à l'étape 3 (décision D5).
model OrderReservation {
  id          String    @id @default(uuid()) @db.Uuid
  orderLineId String    @map("order_line_id") @db.Uuid
  balanceId   String    @map("balance_id") @db.Uuid
  lotId       String    @map("lot_id") @db.Uuid
  quantity    Decimal   @db.Decimal(18, 4)
  releasedAt  DateTime? @map("released_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  line CustomerOrderLine @relation(fields: [orderLineId], references: [id])

  @@index([orderLineId])
  @@map("order_reservations")
}

// ---------------------------------------------------------------------------
// Module 7, étape 3 : sorties de stock et livraisons des commandes clients.
// ---------------------------------------------------------------------------

// Lots sortis du stock à la remise ou à la livraison (mouvement CUSTOMER_DELIVERY).
model CustomerOrderLineIssue {
  id          String    @id @default(uuid()) @db.Uuid
  lineId      String    @map("line_id") @db.Uuid
  deliveryId  String?   @map("delivery_id") @db.Uuid
  productId   String    @map("product_id") @db.Uuid
  lotId       String    @map("lot_id") @db.Uuid
  locationId  String    @map("location_id") @db.Uuid
  quantity    Decimal   @db.Decimal(18, 4)
  unitCost    Decimal   @map("unit_cost") @db.Decimal(18, 4)
  value       Decimal   @db.Decimal(18, 2)
  createdById String    @map("created_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  line     CustomerOrderLine @relation(fields: [lineId], references: [id])
  delivery Delivery?         @relation(fields: [deliveryId], references: [id])

  @@index([lineId])
  @@index([lotId])
  @@map("customer_order_line_issues")
}

enum DeliveryStatus {
  TO_PREPARE // à préparer
  READY // prête
  OUT // en livraison
  DELIVERED // livrée : sortie de stock unique
  FAILED // échouée (motif) : la commande reste à livrer
  CANCELLED
}

model Delivery {
  id              String         @id @default(uuid()) @db.Uuid
  companyId       String         @map("company_id") @db.Uuid
  establishmentId String         @map("establishment_id") @db.Uuid
  orderId         String         @map("order_id") @db.Uuid
  number          String
  clientRequestId String?        @map("client_request_id") @db.Uuid
  status          DeliveryStatus @default(TO_PREPARE)
  // Livreur : un utilisateur de l'établissement.
  driverId        String?        @map("driver_id") @db.Uuid
  address         String
  phone           String?
  scheduledAt     DateTime?      @map("scheduled_at") @db.Timestamptz(3)
  // Frais de livraison (frais du module 7, facturés à l'étape factures ; jamais de stock).
  fee             BigInt         @default(0)
  feeLabel        String?        @map("fee_label")
  notes           String?
  failedReason    String?        @map("failed_reason")
  cancelReason    String?        @map("cancel_reason")
  deliveredAt     DateTime?      @map("delivered_at") @db.Timestamptz(3)
  createdById     String         @map("created_by_id") @db.Uuid
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  order   CustomerOrder           @relation(fields: [orderId], references: [id])
  history DeliveryStatusHistory[]
  issues  CustomerOrderLineIssue[]

  @@unique([companyId, number])
  @@unique([companyId, clientRequestId])
  @@index([establishmentId, status])
  @@index([driverId, status])
  @@map("deliveries")
}

model DeliveryStatusHistory {
  id         String          @id @default(uuid()) @db.Uuid
  deliveryId String          @map("delivery_id") @db.Uuid
  fromStatus DeliveryStatus? @map("from_status")
  toStatus   DeliveryStatus  @map("to_status")
  reason     String?
  userId     String          @map("user_id") @db.Uuid
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  delivery Delivery @relation(fields: [deliveryId], references: [id])

  @@index([deliveryId])
  @@map("delivery_status_history")
}

// --- Module 7, étape 4 : paiements clients, répartitions, acomptes ---------------------

enum CustomerPaymentStatus {
  RECORDED
  CANCELLED // correction d'une erreur : mouvement inverse si la session de caisse est encore ouverte
}

// Paiement reçu d'un client (décision D1 c) : jamais une vente ni du chiffre
// d'affaires. Espèces, mobile money, carte et « autre » passent par la session
// de caisse ouverte de celui qui encaisse (mouvement CUSTOMER_PAYMENT du
// module 5) ; virement et chèque sont enregistrés hors caisse. La partie non
// répartie reste une avance du client.
model CustomerPayment {
  id                 String                @id @default(uuid()) @db.Uuid
  companyId          String                @map("company_id") @db.Uuid
  establishmentId    String                @map("establishment_id") @db.Uuid
  customerId         String                @map("customer_id") @db.Uuid
  number             String
  clientRequestId    String?               @map("client_request_id") @db.Uuid
  status             CustomerPaymentStatus @default(RECORDED)
  method             PaymentMethod
  amount             BigInt
  reference          String?
  provider           String
  sessionId          String?               @map("session_id") @db.Uuid
  cashMovementId     String?               @unique @map("cash_movement_id") @db.Uuid
  reversalMovementId String?               @unique @map("reversal_movement_id") @db.Uuid
  notes              String?
  createdById        String                @map("created_by_id") @db.Uuid
  createdAt          DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  cancelledAt        DateTime?             @map("cancelled_at") @db.Timestamptz(3)
  cancelledById      String?               @map("cancelled_by_id") @db.Uuid
  cancelReason       String?               @map("cancel_reason")

  customer    Customer            @relation(fields: [customerId], references: [id])
  allocations PaymentAllocation[]

  @@unique([companyId, number])
  @@unique([companyId, clientRequestId])
  @@index([customerId])
  @@index([establishmentId, createdAt])
  @@map("customer_payments")
}

// Cible d'une répartition : un acompte, ou une facture (étape 5).
enum AllocationTarget {
  DEPOSIT
  INVOICE
}

// Répartition d'un paiement : jamais au-delà du paiement (contrôle sous verrou
// et trigger) ; libérée, jamais supprimée.
model PaymentAllocation {
  id            String           @id @default(uuid()) @db.Uuid
  paymentId     String           @map("payment_id") @db.Uuid
  target        AllocationTarget
  // Acompte financé ; pour une facture, acompte d'où vient l'argent imputé.
  depositId     String?          @map("deposit_id") @db.Uuid
  invoiceId     String?          @map("invoice_id") @db.Uuid
  amount        BigInt
  createdById   String           @map("created_by_id") @db.Uuid
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  releasedAt    DateTime?        @map("released_at") @db.Timestamptz(3)
  releasedById  String?          @map("released_by_id") @db.Uuid
  releaseReason String?          @map("release_reason")

  payment CustomerPayment @relation(fields: [paymentId], references: [id])
  deposit Deposit?        @relation(fields: [depositId], references: [id])
  invoice Invoice?        @relation(fields: [invoiceId], references: [id])

  @@index([paymentId])
  @@index([depositId])
  @@index([invoiceId])
  @@map("payment_allocations")
}

enum DepositStatus {
  RECEIVED // avance rattachée à la commande
  CUSTOMER_CREDIT // avance conservée en crédit du client (commande annulée, par exemple)
  REFUNDED // entièrement remboursée
  CANCELLED // saisie erronée : répartitions libérées
}

// Acompte (décision D6) : avance du client, hors chiffre d'affaires, reçu ACP.
// TVA éventuelle : À CONFIRMER AVEC LE COMPTABLE (aucune règle codée).
model Deposit {
  id              String        @id @default(uuid()) @db.Uuid
  companyId       String        @map("company_id") @db.Uuid
  establishmentId String        @map("establishment_id") @db.Uuid
  customerId      String        @map("customer_id") @db.Uuid
  orderId         String?       @map("order_id") @db.Uuid
  number          String
  clientRequestId String?       @map("client_request_id") @db.Uuid
  status          DepositStatus @default(RECEIVED)
  amount          BigInt
  refundedAmount  BigInt        @default(0) @map("refunded_amount")
  notes           String?
  createdById     String        @map("created_by_id") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  creditedAt      DateTime?     @map("credited_at") @db.Timestamptz(3)
  creditReason    String?       @map("credit_reason")
  cancelledAt     DateTime?     @map("cancelled_at") @db.Timestamptz(3)
  cancelledById   String?       @map("cancelled_by_id") @db.Uuid
  cancelReason    String?       @map("cancel_reason")

  customer    Customer            @relation(fields: [customerId], references: [id])
  order       CustomerOrder?      @relation(fields: [orderId], references: [id])
  allocations PaymentAllocation[]
  refunds     CustomerRefund[]

  @@unique([companyId, number])
  @@unique([companyId, clientRequestId])
  @@index([customerId])
  @@index([orderId])
  @@map("deposits")
}

// Remboursement d'un acompte ou d'un avoir : par la caisse (mouvement
// CUSTOMER_REFUND du module 5) ou hors caisse (virement, chèque). En ajout seul.
model CustomerRefund {
  id              String        @id @default(uuid()) @db.Uuid
  companyId       String        @map("company_id") @db.Uuid
  establishmentId String        @map("establishment_id") @db.Uuid
  customerId      String        @map("customer_id") @db.Uuid
  depositId       String?       @map("deposit_id") @db.Uuid
  creditNoteId    String?       @map("credit_note_id") @db.Uuid
  clientRequestId String?       @map("client_request_id") @db.Uuid
  method          PaymentMethod
  amount          BigInt
  reference       String?
  provider        String
  sessionId       String?       @map("session_id") @db.Uuid
  cashMovementId  String?       @unique @map("cash_movement_id") @db.Uuid
  reason          String
  createdById     String        @map("created_by_id") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  deposit    Deposit?    @relation(fields: [depositId], references: [id])
  creditNote CreditNote? @relation(fields: [creditNoteId], references: [id])

  @@unique([companyId, clientRequestId])
  @@index([depositId])
  @@index([creditNoteId])
  @@map("customer_refunds")
}

// --- Module 7, étape 5 : factures, avoirs et créances ----------------------------------

enum InvoiceSource {
  ORDER // commande client du module 7
  SALE // ticket du module 5 : jamais une seconde vente ni un second chiffre d'affaires
  MANUAL // prestations du module 7 (lignes « frais », sans stock)
}

// États enregistrés seulement (décision D7) : « payée », « partiellement
// payée » et « échue » se calculent à la lecture.
enum InvoiceStatus {
  DRAFT // sans numéro
  ISSUED // numéro FAC, figée
  DISPUTED // en litige
  CANCELLED // brouillon abandonné, ou facture annulée par un avoir total
}

model Invoice {
  id              String        @id @default(uuid()) @db.Uuid
  companyId       String        @map("company_id") @db.Uuid
  establishmentId String        @map("establishment_id") @db.Uuid
  customerId      String        @map("customer_id") @db.Uuid
  // Numéro FAC attribué à l'émission, dans la transaction (décision D2).
  number          String?
  clientRequestId String?       @map("client_request_id") @db.Uuid
  source          InvoiceSource
  orderId         String?       @map("order_id") @db.Uuid
  saleId          String?       @map("sale_id") @db.Uuid
  status          InvoiceStatus @default(DRAFT)
  total           BigInt
  taxTotal        BigInt        @map("tax_total")
  // Montant déjà réglé à la caisse du module 5 (facture d'un ticket).
  posPaidAmount   BigInt        @default(0) @map("pos_paid_amount")
  // Conditions de paiement du client figées à l'émission.
  paymentTermDays Int?          @map("payment_term_days")
  issuedAt        DateTime?     @map("issued_at") @db.Timestamptz(3)
  issuedById      String?       @map("issued_by_id") @db.Uuid
  dueDate         DateTime?     @map("due_date") @db.Date
  notes           String?
  disputedAt      DateTime?     @map("disputed_at") @db.Timestamptz(3)
  disputeReason   String?       @map("dispute_reason")
  cancelledAt     DateTime?     @map("cancelled_at") @db.Timestamptz(3)
  cancelledById   String?       @map("cancelled_by_id") @db.Uuid
  cancelReason    String?       @map("cancel_reason")
  createdById     String        @map("created_by_id") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  customer    Customer            @relation(fields: [customerId], references: [id])
  order       CustomerOrder?      @relation(fields: [orderId], references: [id])
  lines       InvoiceLine[]
  creditNotes CreditNote[]
  allocations PaymentAllocation[]

  @@unique([companyId, number])
  @@unique([companyId, clientRequestId])
  @@index([customerId])
  @@index([establishmentId, status])
  @@index([orderId])
  @@index([saleId])
  @@map("invoices")
}

// Ligne de facture : copie figée (prix TTC, TVA) de la commande, du ticket ou des frais saisis.
model InvoiceLine {
  id          String           @id @default(uuid()) @db.Uuid
  invoiceId   String           @map("invoice_id") @db.Uuid
  position    Int
  kind        DocumentLineKind
  productId   String?          @map("product_id") @db.Uuid
  productCode String?          @map("product_code")
  // Catégorie copiée de la ligne d'origine (commande ou ticket), jamais relue du catalogue.
  categoryId   String?         @map("category_id") @db.Uuid
  categoryName String?         @map("category_name")
  label       String
  quantity    Decimal          @db.Decimal(18, 4)
  unitPrice   BigInt           @map("unit_price")
  taxRate     Decimal          @map("tax_rate") @db.Decimal(5, 2)
  lineTotal   BigInt           @map("line_total")
  taxAmount   BigInt           @map("tax_amount")
  note        String?
  orderLineId String?          @map("order_line_id") @db.Uuid
  saleItemId  String?          @map("sale_item_id") @db.Uuid
  deliveryId  String?          @map("delivery_id") @db.Uuid

  invoice     Invoice          @relation(fields: [invoiceId], references: [id])
  creditLines CreditNoteLine[]

  @@index([invoiceId])
  @@map("invoice_lines")
}

// Avoir (décision D3) : numéro AVR à l'émission, toujours lié à sa facture,
// jamais au-delà du montant encore corrigeable. Répartition figée de son
// règlement : réduction du reste dû, crédit client, remboursement. En ajout seul.
model CreditNote {
  id              String   @id @default(uuid()) @db.Uuid
  companyId       String   @map("company_id") @db.Uuid
  establishmentId String   @map("establishment_id") @db.Uuid
  customerId      String   @map("customer_id") @db.Uuid
  invoiceId       String   @map("invoice_id") @db.Uuid
  number          String
  clientRequestId String?  @map("client_request_id") @db.Uuid
  total           BigInt
  taxTotal        BigInt   @map("tax_total")
  reason          String
  reducedDue      BigInt   @map("reduced_due")
  customerCredit  BigInt   @map("customer_credit")
  refundAmount    BigInt   @map("refund_amount")
  createdById     String   @map("created_by_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  invoice Invoice          @relation(fields: [invoiceId], references: [id])
  lines   CreditNoteLine[]
  refunds CustomerRefund[]

  @@unique([companyId, number])
  @@unique([companyId, clientRequestId])
  @@index([invoiceId])
  @@map("credit_notes")
}

model CreditNoteLine {
  id            String   @id @default(uuid()) @db.Uuid
  creditNoteId  String   @map("credit_note_id") @db.Uuid
  invoiceLineId String   @map("invoice_line_id") @db.Uuid
  label         String
  quantity      Decimal? @db.Decimal(18, 4)
  amount        BigInt
  taxRate       Decimal  @map("tax_rate") @db.Decimal(5, 2)
  taxAmount     BigInt   @map("tax_amount")

  creditNote  CreditNote  @relation(fields: [creditNoteId], references: [id])
  invoiceLine InvoiceLine @relation(fields: [invoiceLineId], references: [id])

  @@index([creditNoteId])
  @@index([invoiceLineId])
  @@map("credit_note_lines")
}
