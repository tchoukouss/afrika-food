// AFRIKA FOOD — modèle de données
// Module 1 : fondations (entreprise, établissements, utilisateurs, rôles,
// permissions, sessions, sécurité, audit, numérotation).
//
// Conventions :
// - identifiants UUID ;
// - colonnes en snake_case (via @map) ;
// - suppression logique via deleted_at, jamais de DELETE sur les données métier ;
// - montants en FCFA (XOF) stockés en entiers (BigInt) dans les modules financiers.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EstablishmentType {
  PATISSERIE
  RESTAURANT
  PATISSERIE_RESTAURANT
  BOULANGERIE_PATISSERIE
  BOULANGERIE_PATISSERIE_RESTAURANT
}

model Company {
  id         String    @id @default(uuid()) @db.Uuid
  name       String
  legalName  String?   @map("legal_name")
  taxId      String?   @map("tax_id")
  currency   String    @default("XOF") @db.Char(3)
  phone      String?
  email      String?
  address    String?
  logoUrl    String?   @map("logo_url")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(3)

  establishments Establishment[]
  users          User[]
  roles          Role[]
  auditLogs      AuditLog[]
  sequences      DocumentSequence[]

  // Module 2 — catalogue (relations uniquement, aucune colonne ajoutée)
  rawMaterialCategories RawMaterialCategory[]
  rawMaterials          RawMaterial[]
  suppliers             Supplier[]
  productCategories     ProductCategory[]
  products              Product[]

  @@map("companies")
}

model Establishment {
  id            String            @id @default(uuid()) @db.Uuid
  companyId     String            @map("company_id") @db.Uuid
  code          String
  name          String
  type          EstablishmentType
  address       String?
  city          String?
  phone         String?
  email         String?
  receiptHeader String?           @map("receipt_header")
  receiptFooter String?           @map("receipt_footer")
  isActive      Boolean           @default(true) @map("is_active")
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt     DateTime?         @map("deleted_at") @db.Timestamptz(3)

  company   Company    @relation(fields: [companyId], references: [id])
  userRoles UserRole[]
  auditLogs AuditLog[]

  // Module 2 — catalogue (relations uniquement)
  productPrices       ProductPrice[]
  productAvailability ProductAvailability[]

  @@unique([companyId, code])
  @@map("establishments")
}

model User {
  id                 String    @id @default(uuid()) @db.Uuid
  companyId          String    @map("company_id") @db.Uuid
  email              String    @unique
  fullName           String    @map("full_name")
  phone              String?
  passwordHash       String    @map("password_hash")
  isActive           Boolean   @default(true) @map("is_active")
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  failedLoginCount   Int       @default(0) @map("failed_login_count")
  lockedUntil        DateTime? @map("locked_until") @db.Timestamptz(3)
  lastLoginAt        DateTime? @map("last_login_at") @db.Timestamptz(3)
  passwordChangedAt  DateTime? @map("password_changed_at") @db.Timestamptz(3)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz(3)

  company        Company         @relation(fields: [companyId], references: [id])
  userRoles      UserRole[]
  loginSessions  LoginSession[]
  auditLogs      AuditLog[]
  securityEvents SecurityEvent[]

  @@index([companyId])
  @@map("users")
}

model Permission {
  code        String  @id
  module      String
  label       String
  description String?

  rolePermissions RolePermission[]

  @@map("permissions")
}

model Role {
  id          String    @id @default(uuid()) @db.Uuid
  companyId   String    @map("company_id") @db.Uuid
  code        String
  name        String
  description String?
  // Rôle livré par défaut : ses permissions peuvent être ajustées,
  // mais il ne peut pas être supprimé.
  isSystem    Boolean   @default(false) @map("is_system")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)

  company     Company          @relation(fields: [companyId], references: [id])
  permissions RolePermission[]
  userRoles   UserRole[]

  @@unique([companyId, code])
  @@map("roles")
}

model RolePermission {
  roleId         String @map("role_id") @db.Uuid
  permissionCode String @map("permission_code")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionCode], references: [code])

  @@id([roleId, permissionCode])
  @@map("role_permissions")
}

// Attribution d'un rôle à un utilisateur.
// establishment_id NULL = le rôle s'applique à tous les établissements de
// l'entreprise (direction, comptable groupe…).
model UserRole {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  roleId          String   @map("role_id") @db.Uuid
  establishmentId String?  @map("establishment_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  role          Role           @relation(fields: [roleId], references: [id])
  establishment Establishment? @relation(fields: [establishmentId], references: [id])

  @@unique([userId, roleId, establishmentId])
  @@index([userId])
  @@map("user_roles")
}

model LoginSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @map("refresh_token_hash")
  ipAddress        String?   @map("ip_address")
  userAgent        String?   @map("user_agent")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt       DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(3)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedReason    String?   @map("revoked_reason")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("login_sessions")
}

model SecurityEvent {
  id        BigInt   @id @default(autoincrement())
  type      String
  userId    String?  @map("user_id") @db.Uuid
  email     String?
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  details   Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User? @relation(fields: [userId], references: [id])

  @@index([type, createdAt])
  @@index([userId])
  @@map("security_events")
}

// Journal d'audit : en écriture seule. Aucune route ne permet de le modifier
// ni de le supprimer.
model AuditLog {
  id              BigInt   @id @default(autoincrement())
  companyId       String   @map("company_id") @db.Uuid
  establishmentId String?  @map("establishment_id") @db.Uuid
  userId          String?  @map("user_id") @db.Uuid
  action          String
  entityType      String   @map("entity_type")
  entityId        String?  @map("entity_id")
  oldValues       Json?    @map("old_values")
  newValues       Json?    @map("new_values")
  reason          String?
  ipAddress       String?  @map("ip_address")
  userAgent       String?  @map("user_agent")
  sessionId       String?  @map("session_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  company       Company        @relation(fields: [companyId], references: [id])
  establishment Establishment? @relation(fields: [establishmentId], references: [id])
  user          User?          @relation(fields: [userId], references: [id])

  @@index([companyId, createdAt])
  @@index([entityType, entityId])
  @@index([userId])
  @@map("audit_logs")
}

// Compteurs de numérotation (ventes, factures, achats…).
// scope_key = id de l'établissement, ou "GLOBAL" pour une numérotation entreprise.
// L'incrément se fait par INSERT … ON CONFLICT DO UPDATE … RETURNING,
// donc sans doublon même avec plusieurs caisses simultanées.
model DocumentSequence {
  companyId String   @map("company_id") @db.Uuid
  scopeKey  String   @map("scope_key")
  docType   String   @map("doc_type")
  year      Int
  lastValue Int      @default(0) @map("last_value")
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id])

  @@id([companyId, scopeKey, docType, year])
  @@map("document_sequences")
}

// ===========================================================================
// Module 2 — Catalogue : unités, matières premières, fournisseurs, produits.
// Le catalogue est commun à tout le groupe ; les prix et la disponibilité
// peuvent être ajustés par établissement.
// Quantités : Decimal(18,4) exprimées dans l'unité de base de l'article.
// Montants : FCFA entiers (BigInt), prix TTC.
// ===========================================================================

enum UnitDimension {
  MASS
  VOLUME
  COUNT
}

// Unités de mesure (référentiel fixe, alimenté par la migration).
// factor_to_base : 1 g = 0,001 kg ; 1 mL = 0,001 L ; 1 unité = 1 unité.
model Unit {
  code         String        @id
  name         String
  symbol       String
  dimension    UnitDimension
  factorToBase Decimal       @map("factor_to_base") @db.Decimal(18, 6)
  isBase       Boolean       @map("is_base")

  rawMaterials RawMaterial[]
  products     Product[]

  @@map("units")
}

enum RawMaterialKind {
  INGREDIENT
  PACKAGING
  CONSUMABLE
}

model RawMaterialCategory {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  name        String
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  company      Company       @relation(fields: [companyId], references: [id])
  rawMaterials RawMaterial[]

  @@unique([companyId, name])
  @@map("raw_material_categories")
}

// Matière première (farine T55, sucre, beurre, emballages…).
// La marque n'est PAS ici : elle est portée par l'offre fournisseur et par le lot.
model RawMaterial {
  id           String          @id @default(uuid()) @db.Uuid
  companyId    String          @map("company_id") @db.Uuid
  code         String
  name         String
  categoryId   String?         @map("category_id") @db.Uuid
  kind         RawMaterialKind @default(INGREDIENT)
  baseUnitCode String          @map("base_unit_code")
  isPerishable Boolean         @default(false) @map("is_perishable")
  trackLots    Boolean         @default(true) @map("track_lots")
  description  String?
  isActive     Boolean         @default(true) @map("is_active")
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  company          Company                @relation(fields: [companyId], references: [id])
  category         RawMaterialCategory?   @relation(fields: [categoryId], references: [id])
  baseUnit         Unit                   @relation(fields: [baseUnitCode], references: [code])
  packagings       RawMaterialPackaging[]
  supplierProducts SupplierProduct[]

  @@unique([companyId, code])
  @@index([companyId, name])
  @@map("raw_materials")
}

// Conditionnement : « Sac 25 kg » = 25 (kg), « Plaquette 30 œufs » = 30 (unités).
// Sert à afficher et compter le stock en sacs / cartons.
model RawMaterialPackaging {
  id            String   @id @default(uuid()) @db.Uuid
  rawMaterialId String   @map("raw_material_id") @db.Uuid
  name          String
  quantity      Decimal  @db.Decimal(18, 4)
  isDefault     Boolean  @default(false) @map("is_default")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  rawMaterial RawMaterial @relation(fields: [rawMaterialId], references: [id])

  @@unique([rawMaterialId, name])
  @@map("raw_material_packagings")
}

model Supplier {
  id               String   @id @default(uuid()) @db.Uuid
  companyId        String   @map("company_id") @db.Uuid
  code             String
  name             String
  contactName      String?  @map("contact_name")
  phone            String?
  phone2           String?
  email            String?
  address          String?
  city             String?
  taxId            String?  @map("tax_id")
  // Délai de paiement accordé par le fournisseur (jours) et conditions libres.
  paymentTermsDays Int      @default(0) @map("payment_terms_days")
  paymentTerms     String?  @map("payment_terms")
  // Plafond de crédit accordé par le fournisseur, en FCFA (null = non défini).
  creditLimit      BigInt?  @map("credit_limit")
  notes            String?
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  company  Company           @relation(fields: [companyId], references: [id])
  products SupplierProduct[]

  @@unique([companyId, code])
  @@index([companyId, name])
  @@map("suppliers")
}

// Offre d'un fournisseur pour un article : matière première OU produit revendu
// (exactement l'un des deux, contrainte CHECK en base).
// Ex. : Farine T55, marque X, « Sac 25 kg », 25 kg par sac, 18 500 FCFA le sac.
model SupplierProduct {
  id                      String    @id @default(uuid()) @db.Uuid
  supplierId              String    @map("supplier_id") @db.Uuid
  rawMaterialId           String?   @map("raw_material_id") @db.Uuid
  productId               String?   @map("product_id") @db.Uuid
  brand                   String?
  supplierRef             String?   @map("supplier_ref")
  purchaseUnitLabel       String    @map("purchase_unit_label")
  quantityPerPurchaseUnit Decimal   @map("quantity_per_purchase_unit") @db.Decimal(18, 4)
  // Prix de référence négocié par unité d'achat (le prix réel viendra des réceptions).
  unitPrice               BigInt?   @map("unit_price")
  priceUpdatedAt          DateTime? @map("price_updated_at") @db.Timestamptz(3)
  isPreferred             Boolean   @default(false) @map("is_preferred")
  isActive                Boolean   @default(true) @map("is_active")
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  supplier    Supplier     @relation(fields: [supplierId], references: [id])
  rawMaterial RawMaterial? @relation(fields: [rawMaterialId], references: [id])
  product     Product?     @relation(fields: [productId], references: [id])

  @@index([supplierId])
  @@index([rawMaterialId])
  @@index([productId])
  @@map("supplier_products")
}

enum ProductType {
  MANUFACTURED // fabriqué (recette au module 4)
  RESOLD // acheté et revendu tel quel
  MENU // menu / formule composé d'autres produits
}

model ProductCategory {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  name      String
  color     String?
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  company  Company   @relation(fields: [companyId], references: [id])
  products Product[]

  @@unique([companyId, name])
  @@map("product_categories")
}

model Product {
  id           String      @id @default(uuid()) @db.Uuid
  companyId    String      @map("company_id") @db.Uuid
  code         String
  name         String
  categoryId   String?     @map("category_id") @db.Uuid
  type         ProductType
  saleUnitCode String      @default("U") @map("sale_unit_code")
  barcode      String?
  description  String?
  imageUrl     String?     @map("image_url")
  // Taux de TVA inclus dans le prix TTC (0 par défaut).
  taxRate      Decimal     @default(0) @map("tax_rate") @db.Decimal(5, 2)
  isActive     Boolean     @default(true) @map("is_active")
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  company          Company               @relation(fields: [companyId], references: [id])
  category         ProductCategory?      @relation(fields: [categoryId], references: [id])
  saleUnit         Unit                  @relation(fields: [saleUnitCode], references: [code])
  prices           ProductPrice[]
  availability     ProductAvailability[]
  supplierProducts SupplierProduct[]
  menuComponents   ProductComponent[]    @relation("MenuComponents")
  usedInMenus      ProductComponent[]    @relation("ComponentOf")

  @@unique([companyId, code])
  @@unique([companyId, barcode])
  @@index([companyId, name])
  @@map("products")
}

// Historique des prix de vente TTC.
// establishment_id NULL = prix de base du groupe ; sinon prix spécifique au site.
// Prix en vigueur = ligne avec valid_to NULL : une seule par produit et périmètre,
// garantie par un index unique partiel (migration SQL). Un changement ferme
// l'ancienne ligne et en ouvre une nouvelle : rien n'est jamais écrasé.
model ProductPrice {
  id              String    @id @default(uuid()) @db.Uuid
  productId       String    @map("product_id") @db.Uuid
  establishmentId String?   @map("establishment_id") @db.Uuid
  price           BigInt
  validFrom       DateTime  @default(now()) @map("valid_from") @db.Timestamptz(3)
  validTo         DateTime? @map("valid_to") @db.Timestamptz(3)
  createdById     String?   @map("created_by_id") @db.Uuid
  reason          String?

  product       Product        @relation(fields: [productId], references: [id])
  establishment Establishment? @relation(fields: [establishmentId], references: [id])

  @@index([productId, establishmentId, validTo])
  @@map("product_prices")
}

// Disponibilité d'un produit dans un établissement (pas de ligne = disponible).
model ProductAvailability {
  productId       String   @map("product_id") @db.Uuid
  establishmentId String   @map("establishment_id") @db.Uuid
  isAvailable     Boolean  @map("is_available")
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  product       Product       @relation(fields: [productId], references: [id])
  establishment Establishment @relation(fields: [establishmentId], references: [id])

  @@id([productId, establishmentId])
  @@map("product_availability")
}

// Composition d'un menu / d'une formule.
model ProductComponent {
  id                 String  @id @default(uuid()) @db.Uuid
  menuProductId      String  @map("menu_product_id") @db.Uuid
  componentProductId String  @map("component_product_id") @db.Uuid
  quantity           Decimal @db.Decimal(18, 4)

  menu      Product @relation("MenuComponents", fields: [menuProductId], references: [id])
  component Product @relation("ComponentOf", fields: [componentProductId], references: [id])

  @@unique([menuProductId, componentProductId])
  @@map("product_components")
}

// ===========================================================================
// Module 3 — Achats & stock.
//
// Aucune relation Prisma vers les modèles des modules 1 et 2 (pour ne pas les
// modifier) : les clés étrangères vers companies, establishments,
// raw_materials, products, suppliers et users sont déclarées en SQL dans la
// migration. Article = matière première (raw_material_id) OU produit
// (product_id), exactement l'un des deux (contrainte CHECK).
//
// Quantités : Decimal(18,4) dans l'unité de base de l'article.
// Coûts unitaires : Decimal(18,4) FCFA par unité de base. Montants : BigInt FCFA.
// ===========================================================================

model StockLocation {
  id              String   @id @default(uuid()) @db.Uuid
  companyId       String   @map("company_id") @db.Uuid
  establishmentId String   @map("establishment_id") @db.Uuid
  code            String
  name            String
  // Emplacement par défaut (« Magasin principal »), créé automatiquement.
  isDefault       Boolean  @default(false) @map("is_default")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  balances StockBalance[]

  @@unique([establishmentId, code])
  @@map("stock_locations")
}

enum LotOrigin {
  RECEIPT
  INVENTORY
  ADJUSTMENT
}

// Lot : quantité homogène d'un article, avec son coût réel d'achat.
// Le lot appartient à l'entreprise et peut se trouver dans plusieurs
// emplacements (après un transfert) : voir stock_balances.
model StockLot {
  id             String    @id @default(uuid()) @db.Uuid
  companyId      String    @map("company_id") @db.Uuid
  lotNumber      String    @map("lot_number")
  rawMaterialId  String?   @map("raw_material_id") @db.Uuid
  productId      String?   @map("product_id") @db.Uuid
  origin         LotOrigin
  supplierId     String?   @map("supplier_id") @db.Uuid
  brand          String?
  supplierLotRef String?   @map("supplier_lot_ref")
  productionDate DateTime? @map("production_date") @db.Date
  expiryDate     DateTime? @map("expiry_date") @db.Date
  unitCost       Decimal   @map("unit_cost") @db.Decimal(18, 4)
  receiptItemId  String?   @unique @map("receipt_item_id") @db.Uuid
  createdById    String?   @map("created_by_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  balances    StockBalance[]
  receiptItem GoodsReceiptItem? @relation(fields: [receiptItemId], references: [id])

  @@unique([companyId, lotNumber])
  @@index([rawMaterialId])
  @@index([productId])
  @@index([expiryDate])
  @@map("stock_lots")
}

// Solde d'un lot dans un emplacement. Jamais négatif (CHECK en base).
// Disponible = quantity - reserved_quantity.
model StockBalance {
  id               String   @id @default(uuid()) @db.Uuid
  companyId        String   @map("company_id") @db.Uuid
  establishmentId  String   @map("establishment_id") @db.Uuid
  locationId       String   @map("location_id") @db.Uuid
  lotId            String   @map("lot_id") @db.Uuid
  rawMaterialId    String?  @map("raw_material_id") @db.Uuid
  productId        String?  @map("product_id") @db.Uuid
  quantity         Decimal  @default(0) @db.Decimal(18, 4)
  reservedQuantity Decimal  @default(0) @map("reserved_quantity") @db.Decimal(18, 4)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  location StockLocation @relation(fields: [locationId], references: [id])
  lot      StockLot      @relation(fields: [lotId], references: [id])

  @@unique([locationId, lotId])
  @@index([establishmentId, rawMaterialId])
  @@index([establishmentId, productId])
  @@map("stock_balances")
}

enum StockMovementType {
  RECEIPT // réception fournisseur
  SUPPLIER_RETURN // retour au fournisseur
  TRANSFER_OUT // expédition vers un autre établissement
  TRANSFER_IN // réception d'un transfert
  LOCATION_OUT // déplacement entre emplacements (sortie)
  LOCATION_IN // déplacement entre emplacements (entrée)
  INVENTORY_GAIN // écart d'inventaire positif
  INVENTORY_LOSS // écart d'inventaire négatif
  ADJUSTMENT_IN // correction validée (entrée)
  ADJUSTMENT_OUT // correction validée (sortie)
  LOSS // perte / casse / péremption…
}

// Journal des mouvements : en ajout seul (trigger). quantity signée :
// positive = entrée, négative = sortie. Chaque mouvement a une origine.
model StockMovement {
  id              BigInt            @id @default(autoincrement())
  companyId       String            @map("company_id") @db.Uuid
  establishmentId String            @map("establishment_id") @db.Uuid
  locationId      String            @map("location_id") @db.Uuid
  lotId           String            @map("lot_id") @db.Uuid
  rawMaterialId   String?           @map("raw_material_id") @db.Uuid
  productId       String?           @map("product_id") @db.Uuid
  type            StockMovementType
  quantity        Decimal           @db.Decimal(18, 4)
  unitCost        Decimal           @map("unit_cost") @db.Decimal(18, 4)
  value           Decimal           @db.Decimal(18, 2)
  balanceAfter    Decimal           @map("balance_after") @db.Decimal(18, 4)
  originType      String            @map("origin_type")
  originId        String            @map("origin_id") @db.Uuid
  reason          String?
  userId          String?           @map("user_id") @db.Uuid
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([establishmentId, createdAt])
  @@index([lotId])
  @@index([originType, originId])
  @@index([rawMaterialId, createdAt])
  @@index([productId, createdAt])
  @@map("stock_movements")
}

// Stock minimum et seuil d'alerte, par article et par établissement.
model StockThreshold {
  id              String   @id @default(uuid()) @db.Uuid
  companyId       String   @map("company_id") @db.Uuid
  establishmentId String   @map("establishment_id") @db.Uuid
  rawMaterialId   String?  @map("raw_material_id") @db.Uuid
  productId       String?  @map("product_id") @db.Uuid
  minQuantity     Decimal  @map("min_quantity") @db.Decimal(18, 4)
  alertQuantity   Decimal  @map("alert_quantity") @db.Decimal(18, 4)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([establishmentId, rawMaterialId])
  @@unique([establishmentId, productId])
  @@map("stock_thresholds")
}

// --- Achats -----------------------------------------------------------------

enum PurchaseRequestStatus {
  OPEN // en attente de traitement par les achats
  ORDERED // transformée en commande
  REJECTED
  CANCELLED
}

model PurchaseRequest {
  id              String                @id @default(uuid()) @db.Uuid
  companyId       String                @map("company_id") @db.Uuid
  // Identifiant envoyé par le formulaire : un même envoi (double clic, renvoi
  // après coupure réseau) ne crée jamais deux documents.
  clientRequestId String?               @map("client_request_id") @db.Uuid
  establishmentId String                @map("establishment_id") @db.Uuid
  number          String
  status          PurchaseRequestStatus @default(OPEN)
  neededBy        DateTime?             @map("needed_by") @db.Date
  notes           String?
  requestedById   String                @map("requested_by_id") @db.Uuid
  purchaseOrderId String?               @map("purchase_order_id") @db.Uuid
  decidedById     String?               @map("decided_by_id") @db.Uuid
  decidedAt       DateTime?             @map("decided_at") @db.Timestamptz(3)
  decisionNote    String?               @map("decision_note")
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  items         PurchaseRequestItem[]
  purchaseOrder PurchaseOrder?        @relation(fields: [purchaseOrderId], references: [id])

  @@unique([companyId, number])
  @@unique([companyId, clientRequestId])
  @@index([establishmentId, status])
  @@map("purchase_requests")
}

model PurchaseRequestItem {
  id            String  @id @default(uuid()) @db.Uuid
  requestId     String  @map("request_id") @db.Uuid
  rawMaterialId String? @map("raw_material_id") @db.Uuid
  productId     String? @map("product_id") @db.Uuid
  quantity      Decimal @db.Decimal(18, 4)
  note          String?

  request PurchaseRequest @relation(fields: [requestId], references: [id])

  @@map("purchase_request_items")
}

enum PurchaseOrderStatus {
  DRAFT
  VALIDATED
  PARTIALLY_RECEIVED
  RECEIVED
  CLOSED // soldée avec un reliquat non livré
  CANCELLED
}

model PurchaseOrder {
  id              String              @id @default(uuid()) @db.Uuid
  companyId       String              @map("company_id") @db.Uuid
  // Identifiant envoyé par le formulaire : un même envoi (double clic, renvoi
  // après coupure réseau) ne crée jamais deux documents.
  clientRequestId String?             @map("client_request_id") @db.Uuid
  establishmentId String              @map("establishment_id") @db.Uuid
  number          String
  supplierId      String              @map("supplier_id") @db.Uuid
  status          PurchaseOrderStatus @default(DRAFT)
  orderDate       DateTime            @default(now()) @map("order_date") @db.Date
  expectedDate    DateTime?           @map("expected_date") @db.Date
  paymentTerms    String?             @map("payment_terms")
  notes           String?
  // Remise globale sur la commande (FCFA TTC).
  discountAmount  BigInt              @default(0) @map("discount_amount")
  subtotal        BigInt              @default(0)
  total           BigInt              @default(0)
  createdById     String              @map("created_by_id") @db.Uuid
  validatedById   String?             @map("validated_by_id") @db.Uuid
  validatedAt     DateTime?           @map("validated_at") @db.Timestamptz(3)
  closedById      String?             @map("closed_by_id") @db.Uuid
  closedAt        DateTime?           @map("closed_at") @db.Timestamptz(3)
  closeReason     String?             @map("close_reason")
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  items    PurchaseOrderItem[]
  requests PurchaseRequest[]
  receipts GoodsReceipt[]

  @@unique([companyId, number])
  @@unique([companyId, clientRequestId])
  @@index([establishmentId, status])
  @@index([supplierId])
  @@map("purchase_orders")
}

// Ligne de commande, exprimée en unités d'achat (ex. 100 « Sac 25 kg »).
model PurchaseOrderItem {
  id                      String  @id @default(uuid()) @db.Uuid
  orderId                 String  @map("order_id") @db.Uuid
  rawMaterialId           String? @map("raw_material_id") @db.Uuid
  productId               String? @map("product_id") @db.Uuid
  supplierProductId       String? @map("supplier_product_id") @db.Uuid
  purchaseUnitLabel       String  @map("purchase_unit_label")
  quantityPerPurchaseUnit Decimal @map("quantity_per_purchase_unit") @db.Decimal(18, 4)
  orderedQuantity         Decimal @map("ordered_quantity") @db.Decimal(18, 4)
  // Prix TTC par unité d'achat et remise de ligne (FCFA).
  unitPrice               BigInt  @map("unit_price")
  discountAmount          BigInt  @default(0) @map("discount_amount")
  lineTotal               BigInt  @map("line_total")
  // Cumul reçu (accepté), en unités d'achat.
  receivedQuantity        Decimal @default(0) @map("received_quantity") @db.Decimal(18, 4)

  order        PurchaseOrder      @relation(fields: [orderId], references: [id])
  receiptItems GoodsReceiptItem[]

  @@index([orderId])
  @@map("purchase_order_items")
}

// Réception : validée en une fois (contrôle compris) ; elle crée les lots
// et les entrées en stock. Avec ou sans commande (réception directe).
model GoodsReceipt {
  id                  String   @id @default(uuid()) @db.Uuid
  companyId           String   @map("company_id") @db.Uuid
  // Identifiant envoyé par le formulaire : un même envoi (double clic, renvoi
  // après coupure réseau) ne crée jamais deux documents.
  clientRequestId     String?  @map("client_request_id") @db.Uuid
  establishmentId     String   @map("establishment_id") @db.Uuid
  locationId          String   @map("location_id") @db.Uuid
  number              String
  supplierId          String   @map("supplier_id") @db.Uuid
  purchaseOrderId     String?  @map("purchase_order_id") @db.Uuid
  supplierDocumentRef String?  @map("supplier_document_ref")
  receivedAt          DateTime @default(now()) @map("received_at") @db.Timestamptz(3)
  notes               String?
  // Valeur des quantités acceptées (FCFA TTC).
  totalValue          BigInt   @map("total_value")
  receivedById        String   @map("received_by_id") @db.Uuid
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  purchaseOrder PurchaseOrder?           @relation(fields: [purchaseOrderId], references: [id])
  items         GoodsReceiptItem[]
  invoiceLinks  SupplierInvoiceReceipt[]
  returns       SupplierReturn[]

  @@unique([companyId, number])
  @@unique([companyId, clientRequestId])
  @@index([establishmentId, receivedAt])
  @@index([supplierId])
  @@map("goods_receipts")
}

model GoodsReceiptItem {
  id                      String    @id @default(uuid()) @db.Uuid
  receiptId               String    @map("receipt_id") @db.Uuid
  orderItemId             String?   @map("order_item_id") @db.Uuid
  rawMaterialId           String?   @map("raw_material_id") @db.Uuid
  productId               String?   @map("product_id") @db.Uuid
  purchaseUnitLabel       String    @map("purchase_unit_label")
  quantityPerPurchaseUnit Decimal   @map("quantity_per_purchase_unit") @db.Decimal(18, 4)
  // Quantités en unités d'achat : reçue, refusée au contrôle, acceptée.
  receivedQuantity        Decimal   @map("received_quantity") @db.Decimal(18, 4)
  rejectedQuantity        Decimal   @default(0) @map("rejected_quantity") @db.Decimal(18, 4)
  acceptedQuantity        Decimal   @map("accepted_quantity") @db.Decimal(18, 4)
  rejectionReason         String?   @map("rejection_reason")
  // Écart de quantité ou de prix par rapport à la commande : motif obligatoire.
  varianceReason          String?   @map("variance_reason")
  unitPrice               BigInt    @map("unit_price")
  orderedUnitPrice        BigInt?   @map("ordered_unit_price")
  lineValue               BigInt    @map("line_value")
  brand                   String?
  supplierLotRef          String?   @map("supplier_lot_ref")
  productionDate          DateTime? @map("production_date") @db.Date
  expiryDate              DateTime? @map("expiry_date") @db.Date

  receipt   GoodsReceipt       @relation(fields: [receiptId], references: [id])
  orderItem PurchaseOrderItem? @relation(fields: [orderItemId], references: [id])
  lot       StockLot?

  @@index([receiptId])
  @@map("goods_receipt_items")
}

// --- Factures, paiements, retours fournisseurs --------------------------------

enum SupplierInvoiceStatus {
  OPEN
  PARTIALLY_PAID
  PAID
  CANCELLED
}

model SupplierInvoice {
  id              String                @id @default(uuid()) @db.Uuid
  companyId       String                @map("company_id") @db.Uuid
  // Identifiant envoyé par le formulaire : un même envoi (double clic, renvoi
  // après coupure réseau) ne crée jamais deux documents.
  clientRequestId String?               @map("client_request_id") @db.Uuid
  establishmentId String                @map("establishment_id") @db.Uuid
  number          String
  supplierId      String                @map("supplier_id") @db.Uuid
  // Numéro figurant sur la facture du fournisseur.
  supplierRef     String                @map("supplier_ref")
  invoiceDate     DateTime              @map("invoice_date") @db.Date
  dueDate         DateTime              @map("due_date") @db.Date
  amount          BigInt
  // Valeur des réceptions rattachées au moment de l'enregistrement (pour l'écart).
  receivedValue   BigInt                @map("received_value")
  paidAmount      BigInt                @default(0) @map("paid_amount")
  status          SupplierInvoiceStatus @default(OPEN)
  notes           String?
  createdById     String                @map("created_by_id") @db.Uuid
  cancelledById   String?               @map("cancelled_by_id") @db.Uuid
  cancelledAt     DateTime?             @map("cancelled_at") @db.Timestamptz(3)
  cancelReason    String?               @map("cancel_reason")
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  receipts    SupplierInvoiceReceipt[]
  allocations SupplierPaymentAllocation[]
  creditNotes SupplierCreditNote[]

  @@unique([companyId, number])
  @@unique([companyId, clientRequestId])
  @@index([supplierId, status])
  @@map("supplier_invoices")
}

model SupplierInvoiceReceipt {
  invoiceId String @map("invoice_id") @db.Uuid
  receiptId String @map("receipt_id") @db.Uuid

  invoice SupplierInvoice @relation(fields: [invoiceId], references: [id])
  receipt GoodsReceipt    @relation(fields: [receiptId], references: [id])

  @@id([invoiceId, receiptId])
  @@index([receiptId])
  @@map("supplier_invoice_receipts")
}

enum PaymentMethod {
  CASH
  ORANGE_MONEY
  MTN_MONEY
  MOOV_MONEY
  WAVE
  CARD
  BANK_TRANSFER
  CHEQUE
  OTHER
}

// Paiement fournisseur. Jamais supprimé : une annulation est tracée.
// Partie non affectée à une facture = avance.
model SupplierPayment {
  id              String        @id @default(uuid()) @db.Uuid
  companyId       String        @map("company_id") @db.Uuid
  // Identifiant envoyé par le formulaire : un même envoi (double clic, renvoi
  // après coupure réseau) ne crée jamais deux documents.
  clientRequestId String?       @map("client_request_id") @db.Uuid
  establishmentId String        @map("establishment_id") @db.Uuid
  number          String
  supplierId      String        @map("supplier_id") @db.Uuid
  amount          BigInt
  method          PaymentMethod
  reference       String?
  paidAt          DateTime      @default(now()) @map("paid_at") @db.Timestamptz(3)
  notes           String?
  createdById     String        @map("created_by_id") @db.Uuid
  cancelledById   String?       @map("cancelled_by_id") @db.Uuid
  cancelledAt     DateTime?     @map("cancelled_at") @db.Timestamptz(3)
  cancelReason    String?       @map("cancel_reason")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  allocations SupplierPaymentAllocation[]

  @@unique([companyId, number])
  @@unique([companyId, clientRequestId])
  @@index([supplierId])
  @@map("supplier_payments")
}

model SupplierPaymentAllocation {
  id        String   @id @default(uuid()) @db.Uuid
  paymentId String   @map("payment_id") @db.Uuid
  invoiceId String   @map("invoice_id") @db.Uuid
  amount    BigInt
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  payment SupplierPayment @relation(fields: [paymentId], references: [id])
  invoice SupplierInvoice @relation(fields: [invoiceId], references: [id])

  @@index([paymentId])
  @@index([invoiceId])
  @@map("supplier_payment_allocations")
}

model SupplierReturn {
  id              String   @id @default(uuid()) @db.Uuid
  companyId       String   @map("company_id") @db.Uuid
  // Identifiant envoyé par le formulaire : un même envoi (double clic, renvoi
  // après coupure réseau) ne crée jamais deux documents.
  clientRequestId String?  @map("client_request_id") @db.Uuid
  establishmentId String   @map("establishment_id") @db.Uuid
  locationId      String   @map("location_id") @db.Uuid
  number          String
  supplierId      String   @map("supplier_id") @db.Uuid
  receiptId       String?  @map("receipt_id") @db.Uuid
  reason          String
  totalValue      BigInt   @map("total_value")
  createdById     String   @map("created_by_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  receipt    GoodsReceipt?        @relation(fields: [receiptId], references: [id])
  items      SupplierReturnItem[]
  creditNote SupplierCreditNote?

  @@unique([companyId, number])
  @@unique([companyId, clientRequestId])
  @@map("supplier_returns")
}

model SupplierReturnItem {
  id       String  @id @default(uuid()) @db.Uuid
  returnId String  @map("return_id") @db.Uuid
  lotId    String  @map("lot_id") @db.Uuid
  quantity Decimal @db.Decimal(18, 4)
  unitCost Decimal @map("unit_cost") @db.Decimal(18, 4)
  value    BigInt

  supplierReturn SupplierReturn @relation(fields: [returnId], references: [id])

  @@map("supplier_return_items")
}

// Avoir fournisseur (issu d'un retour). S'il est rattaché à une facture,
// il compte dans le montant réglé de cette facture ; sinon il réduit le solde.
model SupplierCreditNote {
  id         String   @id @default(uuid()) @db.Uuid
  companyId  String   @map("company_id") @db.Uuid
  number     String
  supplierId String   @map("supplier_id") @db.Uuid
  returnId   String   @unique @map("return_id") @db.Uuid
  invoiceId  String?  @map("invoice_id") @db.Uuid
  amount     BigInt
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  supplierReturn SupplierReturn   @relation(fields: [returnId], references: [id])
  invoice        SupplierInvoice? @relation(fields: [invoiceId], references: [id])

  @@unique([companyId, number])
  @@index([supplierId])
  @@map("supplier_credit_notes")
}

// --- Inventaires, corrections, pertes, déplacements ---------------------------

enum InventoryStatus {
  OPEN
  VALIDATED
  CANCELLED
}

// Tant qu'un inventaire est OPEN, son emplacement est gelé (aucun mouvement).
model InventorySession {
  id              String          @id @default(uuid()) @db.Uuid
  companyId       String          @map("company_id") @db.Uuid
  establishmentId String          @map("establishment_id") @db.Uuid
  locationId      String          @map("location_id") @db.Uuid
  number          String
  status          InventoryStatus @default(OPEN)
  notes           String?
  openedById      String          @map("opened_by_id") @db.Uuid
  openedAt        DateTime        @default(now()) @map("opened_at") @db.Timestamptz(3)
  closedById      String?         @map("closed_by_id") @db.Uuid
  closedAt        DateTime?       @map("closed_at") @db.Timestamptz(3)

  items InventoryItem[]

  @@unique([companyId, number])
  @@index([locationId, status])
  @@map("inventory_sessions")
}

model InventoryItem {
  id                  String    @id @default(uuid()) @db.Uuid
  sessionId           String    @map("session_id") @db.Uuid
  rawMaterialId       String?   @map("raw_material_id") @db.Uuid
  productId           String?   @map("product_id") @db.Uuid
  // Stock théorique figé à l'ouverture (l'emplacement est gelé ensuite).
  theoreticalQuantity Decimal   @map("theoretical_quantity") @db.Decimal(18, 4)
  countedQuantity     Decimal?  @map("counted_quantity") @db.Decimal(18, 4)
  // Coût unitaire des quantités en plus (proposé, modifiable).
  unitCost            Decimal?  @map("unit_cost") @db.Decimal(18, 4)
  justification       String?
  countedById         String?   @map("counted_by_id") @db.Uuid
  countedAt           DateTime? @map("counted_at") @db.Timestamptz(3)

  session InventorySession @relation(fields: [sessionId], references: [id])

  @@index([sessionId])
  @@map("inventory_items")
}

enum AdjustmentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AdjustmentDirection {
  IN
  OUT
}

// Correction de stock : demandée, puis validée (ou refusée) par un responsable.
model StockAdjustment {
  id              String              @id @default(uuid()) @db.Uuid
  companyId       String              @map("company_id") @db.Uuid
  // Identifiant envoyé par le formulaire : un même envoi (double clic, renvoi
  // après coupure réseau) ne crée jamais deux documents.
  clientRequestId String?             @map("client_request_id") @db.Uuid
  establishmentId String              @map("establishment_id") @db.Uuid
  locationId      String              @map("location_id") @db.Uuid
  number          String
  status          AdjustmentStatus    @default(PENDING)
  rawMaterialId   String?             @map("raw_material_id") @db.Uuid
  productId       String?             @map("product_id") @db.Uuid
  direction       AdjustmentDirection
  quantity        Decimal             @db.Decimal(18, 4)
  // Sortie : lot visé (facultatif, FEFO sinon). Entrée : coût unitaire du nouveau lot.
  lotId           String?             @map("lot_id") @db.Uuid
  unitCost        Decimal?            @map("unit_cost") @db.Decimal(18, 4)
  reason          String
  requestedById   String              @map("requested_by_id") @db.Uuid
  decidedById     String?             @map("decided_by_id") @db.Uuid
  decidedAt       DateTime?           @map("decided_at") @db.Timestamptz(3)
  decisionNote    String?             @map("decision_note")
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([companyId, number])
  @@unique([companyId, clientRequestId])
  @@index([establishmentId, status])
  @@map("stock_adjustments")
}

enum LossCause {
  EXPIRED
  BURNT
  BROKEN
  PRODUCTION_ERROR
  CUSTOMER_RETURN
  QUALITY
  TRANSIT
  OTHER
}

model StockLoss {
  id              String    @id @default(uuid()) @db.Uuid
  companyId       String    @map("company_id") @db.Uuid
  // Identifiant envoyé par le formulaire : un même envoi (double clic, renvoi
  // après coupure réseau) ne crée jamais deux documents.
  clientRequestId String?   @map("client_request_id") @db.Uuid
  establishmentId String    @map("establishment_id") @db.Uuid
  // NULL pour une perte en transit (le stock avait déjà quitté l'emplacement).
  locationId      String?   @map("location_id") @db.Uuid
  number          String
  rawMaterialId   String?   @map("raw_material_id") @db.Uuid
  productId       String?   @map("product_id") @db.Uuid
  lotId           String?   @map("lot_id") @db.Uuid
  quantity        Decimal   @db.Decimal(18, 4)
  cause           LossCause
  comment         String?
  estimatedValue  BigInt    @map("estimated_value")
  transferId      String?   @map("transfer_id") @db.Uuid
  declaredById    String    @map("declared_by_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([companyId, number])
  @@unique([companyId, clientRequestId])
  @@index([establishmentId, createdAt])
  @@map("stock_losses")
}

// Déplacement de stock entre deux emplacements d'un même établissement.
model LocationMove {
  id              String   @id @default(uuid()) @db.Uuid
  companyId       String   @map("company_id") @db.Uuid
  // Identifiant envoyé par le formulaire : un même envoi (double clic, renvoi
  // après coupure réseau) ne crée jamais deux documents.
  clientRequestId String?  @map("client_request_id") @db.Uuid
  establishmentId String   @map("establishment_id") @db.Uuid
  number          String
  fromLocationId  String   @map("from_location_id") @db.Uuid
  toLocationId    String   @map("to_location_id") @db.Uuid
  rawMaterialId   String?  @map("raw_material_id") @db.Uuid
  productId       String?  @map("product_id") @db.Uuid
  quantity        Decimal  @db.Decimal(18, 4)
  reason          String?
  createdById     String   @map("created_by_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([companyId, number])
  @@unique([companyId, clientRequestId])
  @@map("location_moves")
}

// --- Transferts entre établissements ------------------------------------------

enum TransferStatus {
  REQUESTED
  VALIDATED
  PREPARED
  SHIPPED
  RECEIVED
  CLOSED
  CANCELLED
}

model StockTransfer {
  id                    String         @id @default(uuid()) @db.Uuid
  companyId             String         @map("company_id") @db.Uuid
  // Identifiant envoyé par le formulaire : un même envoi (double clic, renvoi
  // après coupure réseau) ne crée jamais deux documents.
  clientRequestId       String?        @map("client_request_id") @db.Uuid
  number                String
  sourceEstablishmentId String         @map("source_establishment_id") @db.Uuid
  sourceLocationId      String?        @map("source_location_id") @db.Uuid
  destEstablishmentId   String         @map("dest_establishment_id") @db.Uuid
  destLocationId        String?        @map("dest_location_id") @db.Uuid
  status                TransferStatus @default(REQUESTED)
  notes                 String?
  requestedById         String         @map("requested_by_id") @db.Uuid
  requestedAt           DateTime       @default(now()) @map("requested_at") @db.Timestamptz(3)
  validatedById         String?        @map("validated_by_id") @db.Uuid
  validatedAt           DateTime?      @map("validated_at") @db.Timestamptz(3)
  preparedById          String?        @map("prepared_by_id") @db.Uuid
  preparedAt            DateTime?      @map("prepared_at") @db.Timestamptz(3)
  shippedById           String?        @map("shipped_by_id") @db.Uuid
  shippedAt             DateTime?      @map("shipped_at") @db.Timestamptz(3)
  receivedById          String?        @map("received_by_id") @db.Uuid
  receivedAt            DateTime?      @map("received_at") @db.Timestamptz(3)
  closedById            String?        @map("closed_by_id") @db.Uuid
  closedAt              DateTime?      @map("closed_at") @db.Timestamptz(3)
  cancelledById         String?        @map("cancelled_by_id") @db.Uuid
  cancelledAt           DateTime?      @map("cancelled_at") @db.Timestamptz(3)
  cancelReason          String?        @map("cancel_reason")
  createdAt             DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  items StockTransferItem[]

  @@unique([companyId, number])
  @@unique([companyId, clientRequestId])
  @@index([sourceEstablishmentId, status])
  @@index([destEstablishmentId, status])
  @@map("stock_transfers")
}

model StockTransferItem {
  id                String   @id @default(uuid()) @db.Uuid
  transferId        String   @map("transfer_id") @db.Uuid
  rawMaterialId     String?  @map("raw_material_id") @db.Uuid
  productId         String?  @map("product_id") @db.Uuid
  requestedQuantity Decimal  @map("requested_quantity") @db.Decimal(18, 4)
  // Quantité préparée (peut différer de la demande), puis expédiée et reçue.
  preparedQuantity  Decimal? @map("prepared_quantity") @db.Decimal(18, 4)
  shippedQuantity   Decimal? @map("shipped_quantity") @db.Decimal(18, 4)
  receivedQuantity  Decimal? @map("received_quantity") @db.Decimal(18, 4)
  gapReason         String?  @map("gap_reason")

  transfer StockTransfer      @relation(fields: [transferId], references: [id])
  lots     StockTransferLot[]

  @@index([transferId])
  @@map("stock_transfer_items")
}

// Lots expédiés pour une ligne de transfert (traçabilité de bout en bout).
model StockTransferLot {
  id               String   @id @default(uuid()) @db.Uuid
  transferItemId   String   @map("transfer_item_id") @db.Uuid
  lotId            String   @map("lot_id") @db.Uuid
  shippedQuantity  Decimal  @map("shipped_quantity") @db.Decimal(18, 4)
  receivedQuantity Decimal? @map("received_quantity") @db.Decimal(18, 4)
  unitCost         Decimal  @map("unit_cost") @db.Decimal(18, 4)

  transferItem StockTransferItem @relation(fields: [transferItemId], references: [id])

  @@map("stock_transfer_lots")
}
